# Environment variables for the /auto-improve loop.
#
# Copy this file to .env.claude.local and fill in the values.
# .env.claude.local is gitignored — never commit it.
#
# These variables are only needed if you want to run the /auto-improve
# loop with Discord integration. The mobile app and web site build
# without them.

# Bot token for the Discord integration (reading #task-queue,
# posting summaries to #auto-improvements). Required for /auto-improve.
# Create a bot at https://discord.com/developers/applications.
DISCORD_TOKEN=

# Optional: TTS server for the "expedition departs" announcement.
# This is a personal homelab endpoint and won't be available on
# external machines. The loop continues without it (curl || true).
# HOME_TTS_URL=https://your-tts-server/say

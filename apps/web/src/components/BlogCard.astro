---
interface Props {
  href: string;
  title: string;
  summary: string;
  pubDate: Date;
  loopId?: string | undefined;
  tags?: readonly string[] | undefined;
}

const { href, title, summary, pubDate, loopId, tags } = Astro.props;

const formatted = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const iso = pubDate.toISOString();
// Cap the tag count rendered on a card — long tag lists wrap and visually
// overwhelm the title. Three is enough to signal scope without crowding.
const visibleTags = (tags ?? []).slice(0, 3);
---

<a class="card" href={href}>
  <header class="card__head">
    <time class="card__date" datetime={iso}>{formatted}</time>
    {loopId && <span class="card__loop">{loopId}</span>}
  </header>
  <h3 class="card__title">{title.replace(/\.$/, '')}<span class="card__dot" aria-hidden="true">.</span></h3>
  <p class="card__summary">{summary}</p>
  {visibleTags.length > 0 && (
    <ul class="card__tags" aria-label="Tags">
      {visibleTags.map((t) => (
        <li class="card__tag">{t}</li>
      ))}
    </ul>
  )}
  <span class="card__cta">Read entry →</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl);
    background: var(--bg-1);
    border: 1px solid var(--line-faint);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  .card:hover {
    border-color: var(--line);
    transform: translateY(-1px);
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .card__loop {
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }

  .card__title {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink-0);
    margin: 0;
  }

  .card__dot {
    color: var(--amber);
    margin-left: -0.04em;
  }

  .card__summary {
    color: var(--ink-1);
    line-height: 1.55;
  }

  .card__cta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-0);
    margin-top: var(--space-xs);
  }

  .card__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .card__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--line-faint);
    border-radius: var(--radius-pill);
    padding: 2px 8px;
  }
</style>

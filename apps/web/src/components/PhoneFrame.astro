---
/*
 * A pure-CSS phone frame that houses the app-screen mockups on the
 * marketing site. No images, no JS — the inner <slot> is HTML that
 * inherits the e-ink tokens, so the mockups read identically to the
 * real app at a glance.
 *
 * Mockups don't need pixel parity with the running app. They need to
 * be unmistakably the app to anyone who has used it, and immediately
 * comprehensible to anyone who hasn't.
 */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="phone">
  <div class="phone__device" aria-hidden="true">
    <div class="phone__notch"></div>
    <div class="phone__screen">
      <slot />
    </div>
  </div>
  {caption && <figcaption class="phone__caption">{caption}</figcaption>}
</figure>

<style>
  .phone {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .phone__device {
    --phone-width: 280px;
    --phone-height: 580px;
    width: var(--phone-width);
    height: var(--phone-height);
    background: var(--ink-0);
    border-radius: 38px;
    padding: 8px;
    box-shadow:
      0 0 0 1px rgba(26, 24, 18, 0.55),
      0 22px 50px -22px rgba(26, 24, 18, 0.4),
      0 8px 20px -10px rgba(26, 24, 18, 0.15);
    position: relative;
  }

  .phone__notch {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 78px;
    height: 22px;
    background: var(--ink-0);
    border-radius: 0 0 12px 12px;
    z-index: 2;
  }

  .phone__screen {
    width: 100%;
    height: 100%;
    background: var(--bg-0);
    border-radius: 30px;
    overflow: hidden;
    position: relative;
    color: var(--ink-0);
    font-family: var(--font-sans);
    line-height: 1.4;
    font-size: 14px;
  }

  .phone__caption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
</style>

---
const path = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="masthead">
  <div class="masthead-inner">
    <a href="/" class="wordmark" aria-label="531 Strength home">
      <span class="num">531</span><span class="mid" aria-hidden="true">·</span><span class="sub">ledger</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]}>Home</a>
      <a href="/#program" class="nav-link">Program</a>
      <a href="/process" class:list={['nav-link', { active: isActive('/process') }]}>Process</a>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Dev log</a>
    </nav>
    <div class="masthead-right">
      <a href="/#get" class="pill">
        Get it
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <button class="menu-btn" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" aria-hidden="true">
  <div class="mobile-nav-inner">
    <nav class="mobile-nav-links" aria-label="Mobile navigation">
      <a href="/" class:list={['mobile-nav-link', { active: isActive('/') }]}>Home</a>
      <a href="/#program" class="mobile-nav-link">Program</a>
      <a href="/process" class:list={['mobile-nav-link', { active: isActive('/process') }]}>Process</a>
      <a href="/blog" class:list={['mobile-nav-link', { active: isActive('/blog') }]}>Dev log</a>
    </nav>
    <a href="/#get" class="mobile-cta">
      Get it
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const masthead = document.querySelector<HTMLElement>('.masthead');

  function anchorNav() {
    if (masthead && nav) {
      nav.style.top = `${masthead.offsetHeight}px`;
    }
  }
  anchorNav();
  window.addEventListener('resize', anchorNav, { passive: true });

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      nav.setAttribute('aria-hidden', String(open));
      nav.classList.toggle('is-open', !open);
      toggle.classList.toggle('is-open', !open);
      document.body.style.overflow = open ? '' : 'hidden';
    });
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        nav.setAttribute('aria-hidden', 'true');
        nav.classList.remove('is-open');
        toggle.classList.remove('is-open');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(231, 227, 214, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .masthead-inner {
    max-width: var(--content-wide);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px var(--gutter);
    gap: 24px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--ink-0);
  }
  .wordmark .num { color: var(--ink-0); }
  .wordmark .mid { color: var(--ink-3); font-weight: 500; }
  .wordmark .sub {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }

  .nav {
    display: flex;
    gap: 24px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-1);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .nav-link:hover { color: var(--ink-0); }
  .nav-link.active {
    color: var(--ink-0);
    position: relative;
  }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -6px;
    height: 1px;
    background: var(--amber);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    background: var(--ink-0);
    color: var(--bg-0);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--ink-0);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard);
    white-space: nowrap;
  }
  .pill:hover { transform: translateY(-1px); }
  .pill svg { width: 13px; height: 13px; display: block; }

  .masthead-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--line-strong);
    cursor: pointer;
    padding: 10px;
    flex: none;
  }
  .menu-bar {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--ink-0);
    transform-origin: center;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }
  .menu-btn.is-open .menu-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-btn.is-open .menu-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-btn.is-open .menu-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
    position: fixed;
    inset: 0;
    top: 0;
    z-index: 40;
    background: var(--bg-0);
    border-top: 1px solid var(--line);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .mobile-nav.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .mobile-nav-inner {
    padding: 32px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .mobile-nav-link {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-1);
    text-decoration: none;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--ink-0);
  }
  .mobile-nav-link.active {
    position: relative;
  }
  .mobile-nav-link.active::before {
    content: "·";
    position: absolute;
    left: -16px;
    color: var(--amber);
  }
  .mobile-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    background: var(--ink-0);
    color: var(--bg-0);
    border: 1px solid var(--ink-0);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    align-self: flex-start;
  }
  .mobile-cta svg { width: 14px; height: 14px; display: block; }

  @media (max-width: 720px) {
    .nav { display: none; }
    .pill { display: none; }
    .menu-btn { display: flex; }
    .mobile-nav { display: block; }
  }
</style>

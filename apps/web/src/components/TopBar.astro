---
const path = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="masthead">
  <div class="masthead-inner">
    <a href="/" class="wordmark" aria-label="531 ledger home">
      <span class="num">531</span><span class="mid" aria-hidden="true">·</span><span class="sub">ledger</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]}>Home</a>
      <a href="/#program" class="nav-link">Program</a>
      <a href="/process" class:list={['nav-link', { active: isActive('/process') }]}>Process</a>
      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Dev log</a>
    </nav>
    <a href="/#get" class="pill">
      Get it
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(231, 227, 214, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .masthead-inner {
    max-width: var(--content-wide);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px var(--gutter);
    gap: 24px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--ink-0);
  }
  .wordmark .num { color: var(--ink-0); }
  .wordmark .mid { color: var(--ink-3); font-weight: 500; }
  .wordmark .sub {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }

  .nav {
    display: flex;
    gap: 24px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-1);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .nav-link:hover { color: var(--ink-0); }
  .nav-link.active {
    color: var(--ink-0);
    position: relative;
  }
  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -6px;
    height: 1px;
    background: var(--amber);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    background: var(--ink-0);
    color: var(--bg-0);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--ink-0);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard);
    white-space: nowrap;
  }
  .pill:hover { transform: translateY(-1px); }
  .pill svg { width: 13px; height: 13px; display: block; }

  @media (max-width: 720px) {
    .nav { display: none; }
  }
</style>

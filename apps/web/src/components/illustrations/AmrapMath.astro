---
/*
 * The "AMRAP math" feature card. Editorial breakdown of the Epley
 * formula being applied to the current set, plus a tape of recent
 * AMRAPs with their estimated 1RMs and deltas vs. the running best.
 *
 * Mirrors what the receipt/history surfaces in the app, but rendered
 * as a single static page object — no phone frame, no scroll.
 */

const tape = [
  { cycle: 'C4·W3', lift: 'DL',  set: '345×6', e1rm: 414, delta: '+29' },
  { cycle: 'C4·W3', lift: 'BP',  set: '255×3', e1rm: 281, delta: '+4'  },
  { cycle: 'C4·W3', lift: 'SQ',  set: '335×3', e1rm: 369, delta: '−2'  },
  { cycle: 'C4·W3', lift: 'OHP', set: '160×4', e1rm: 181, delta: '+1'  },
  { cycle: 'C4·W2', lift: 'DL',  set: '320×5', e1rm: 373, delta: '—'   },
  { cycle: 'C4·W2', lift: 'BP',  set: '240×4', e1rm: 272, delta: '+3'  },
  { cycle: 'C4·W2', lift: 'SQ',  set: '315×4', e1rm: 357, delta: '+5'  },
];
---

<div class="amrap">
  <div class="amrap__head">
    <span class="amrap__eyebrow">AMRAP · ESTIMATED 1RM</span>
    <span class="amrap__formula">e1RM = w × (1 + r / 30)</span>
  </div>

  <div class="amrap__work">
    <div class="amrap__cell amrap__cell--w">
      <span class="amrap__cell-k">WEIGHT</span>
      <span class="amrap__cell-v">345</span>
      <span class="amrap__cell-u">lb</span>
    </div>
    <span class="amrap__op">×</span>
    <div class="amrap__cell amrap__cell--paren">
      <span class="amrap__cell-k">FACTOR</span>
      <span class="amrap__cell-v">
        <span class="paren">(</span>1 + <span class="r">6</span> / 30<span class="paren">)</span>
      </span>
      <span class="amrap__cell-u">= 1.200</span>
    </div>
    <span class="amrap__op">=</span>
    <div class="amrap__cell amrap__cell--out">
      <span class="amrap__cell-k">e1RM</span>
      <span class="amrap__cell-v amrap__cell-v--out">414</span>
      <span class="amrap__cell-u amrap__cell-u--accent">+29 vs. prior best</span>
    </div>
  </div>

  <div class="amrap__tape">
    <div class="amrap__tape-head">
      <span>CYCLE</span><span>LIFT</span><span>SET</span><span>e1RM</span><span>Δ</span>
    </div>
    {tape.map((t) => (
      <div class="amrap__tape-row">
        <span class="c">{t.cycle}</span>
        <span class="l">{t.lift}</span>
        <span class="s">{t.set}</span>
        <span class="e">{t.e1rm}</span>
        <span class:list={['d', { 'd--up': t.delta.startsWith('+'), 'd--down': t.delta.startsWith('−'), 'd--flat': t.delta === '—' }]}>{t.delta}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .amrap {
    background: var(--bg-1);
    padding: var(--space-xl);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .amrap__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-sm);
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .amrap__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .amrap__formula {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-1);
    font-variant-numeric: tabular-nums;
  }

  .amrap__work {
    display: grid;
    grid-template-columns: 1fr auto 1.2fr auto 1.1fr;
    align-items: center;
    gap: var(--space-md);
  }
  @media (max-width: 720px) {
    .amrap__work {
      grid-template-columns: 1fr;
    }
    .amrap__op {
      text-align: center;
    }
  }

  .amrap__cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: var(--bg-0);
    border: 1px solid var(--line-faint);
  }
  .amrap__cell--out {
    background: var(--ink-0);
    color: var(--bg-0);
    border-color: var(--ink-0);
  }
  .amrap__cell-k {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .amrap__cell--out .amrap__cell-k {
    color: var(--ink-4);
  }
  .amrap__cell-v {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink-0);
    font-variant-numeric: tabular-nums;
  }
  .amrap__cell-v--out {
    color: var(--bg-0);
    font-size: 3rem;
  }
  .amrap__cell--paren .amrap__cell-v {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--ink-1);
    font-weight: 500;
  }
  .amrap__cell--paren .paren {
    color: var(--ink-3);
  }
  .amrap__cell--paren .r {
    color: var(--ink-0);
    font-weight: 600;
  }
  .amrap__cell-u {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .amrap__cell--out .amrap__cell-u {
    color: var(--ink-4);
  }
  .amrap__cell-u--accent {
    color: var(--amber) !important;
  }
  .amrap__op {
    font-family: var(--font-cond);
    font-size: 2rem;
    color: var(--ink-3);
    font-weight: 500;
    text-align: center;
  }

  .amrap__tape {
    border-top: 1px solid var(--line);
    padding-top: var(--space-sm);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
  }
  .amrap__tape-head,
  .amrap__tape-row {
    display: grid;
    grid-template-columns: 1.1fr 0.6fr 1fr 0.8fr 0.7fr;
    align-items: baseline;
    gap: 8px;
    padding: 6px 8px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .amrap__tape-head {
    color: var(--ink-3);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
  }
  .amrap__tape-row {
    font-size: 0.82rem;
    color: var(--ink-1);
    border-bottom: 1px dotted var(--line-faint);
  }
  .amrap__tape-row:hover {
    background: var(--bg-0);
  }
  .amrap__tape-row .c { color: var(--ink-2); font-size: 0.72rem; }
  .amrap__tape-row .l { color: var(--ink-0); font-weight: 600; letter-spacing: 0.06em; }
  .amrap__tape-row .s { color: var(--ink-0); }
  .amrap__tape-row .e { color: var(--ink-0); font-weight: 600; }
  .amrap__tape-row .d--up { color: var(--amber); font-weight: 600; }
  .amrap__tape-row .d--down { color: var(--ink-2); }
  .amrap__tape-row .d--flat { color: var(--ink-3); }
</style>

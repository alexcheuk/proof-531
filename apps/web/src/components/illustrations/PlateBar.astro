---
/*
 * Pure-CSS port of the mobile PlateBar primitive
 * (apps/mobile/src/design/primitives/PlateBar). Side-view barbell
 * visualization with heaviest plates closest to the bar. Plate height
 * is driven by the same `sizeFor(weight, unitGlyph)` ramp the mobile
 * app uses, so the marketing illustration is visually faithful to what
 * the user sees on the rest screen.
 *
 * No JS, no images. Just nested flex rows and a tabular caption.
 */

interface Props {
  /** Plates per side, heaviest first. Loader is responsible for ordering. */
  perSide: number[];
  /** "lb" or "kg". Drives the size ramp + caption glyph. */
  unitGlyph?: string;
  /** Total weight on the bar. Bar weight is included by convention (45 lb). */
  weight: number;
  /** Visual scale variant. */
  size?: 'lg' | 'md' | 'sm';
  /** Optional band above the bar, e.g. "WORKING · SET 03 · AMRAP". */
  label?: string;
  /** Suppress the PER SIDE caption (used in mini variants / strips). */
  hideCaption?: boolean;
}

const {
  perSide,
  unitGlyph = 'lb',
  weight,
  size = 'lg',
  label,
  hideCaption = false,
} = Astro.props;

// Same ramp as plateMath.ts (mobile). 1.25→25 for kg, 2.5→45 for lb.
function sizeFor(plate: number, glyph: string): number {
  const isKg = glyph === 'kg';
  const max = isKg ? 25 : 45;
  const min = isKg ? 1.25 : 2.5;
  const t = Math.max(0, Math.min(1, (plate - min) / (max - min)));
  return 0.36 + t * 0.64;
}

// Run-length group for the PER SIDE caption.
type Group = { weight: number; count: number };
const grouped: Group[] = [];
for (const p of perSide) {
  const last = grouped[grouped.length - 1];
  if (last && last.weight === p) last.count += 1;
  else grouped.push({ weight: p, count: 1 });
}

const perSideTotal = perSide.reduce((s, p) => s + p, 0);

// Per-size visual ramp. H = total bar+plate viewport height in px.
const H = size === 'lg' ? 168 : size === 'md' ? 112 : 64;
const plateW = size === 'lg' ? 22 : size === 'md' ? 15 : 9;
const sleeveH = size === 'lg' ? 6 : size === 'md' ? 5 : 4;
const barMidW = size === 'lg' ? 110 : size === 'md' ? 70 : 36;
const collarH = Math.round(H * 0.32);
---

<figure class:list={['platebar', `platebar--${size}`]}
  data-weight={weight}
  data-unit={unitGlyph}
  style={`--H: ${H}px; --plate-w: ${plateW}px; --sleeve-h: ${sleeveH}px; --bar-mid-w: ${barMidW}px; --collar-h: ${collarH}px;`}
>
  {label && <figcaption class="platebar__label">{label}</figcaption>}

  <div class="platebar__row" aria-hidden="true">
    <div class="platebar__stack platebar__stack--left">
      {perSide.map((p) => (
        <span
          class="plate"
          style={`height: ${Math.round(H * sizeFor(p, unitGlyph))}px`}
        >
          <span class="plate__num">{p}</span>
        </span>
      ))}
    </div>

    {perSide.length > 0 && <span class="collar" />}
    <span class="bar-mid" />
    {perSide.length > 0 && <span class="collar" />}

    <div class="platebar__stack platebar__stack--right">
      {perSide.map((p) => (
        <span
          class="plate"
          style={`height: ${Math.round(H * sizeFor(p, unitGlyph))}px`}
        >
          <span class="plate__num">{p}</span>
        </span>
      ))}
    </div>
  </div>

  {!hideCaption && (
    <div class="platebar__cap">
      <span class="platebar__cap-label">PER SIDE</span>
      <div class="platebar__cap-eq">
        {grouped.length === 0 ? (
          <span class="dash">—</span>
        ) : (
          <>
            {grouped.map((g, i) => (
              <>
                {i > 0 && <span class="plus">+</span>}
                <span class="grp">
                  {g.count > 1 && <span class="count">{g.count}× </span>}
                  <span class="num">{g.weight}</span>
                </span>
              </>
            ))}
            <span class="total">{`= ${perSideTotal} ${unitGlyph}`}</span>
          </>
        )}
      </div>
    </div>
  )}

  {!hideCaption && (
    <div class="platebar__readout">
      <span class="platebar__readout-label">ON THE BAR</span>
      <span class="platebar__readout-weight">{weight}</span>
      <span class="platebar__readout-unit">{unitGlyph}</span>
    </div>
  )}
</figure>

<style>
  .platebar {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .platebar__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .platebar__row {
    height: var(--H);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .platebar__stack {
    display: flex;
    align-items: center;
    gap: 1px;
  }
  /* Heaviest plate sits closest to the bar; the left stack reverses so
     index-0 is innermost on both sides. */
  .platebar__stack--left {
    flex-direction: row-reverse;
  }

  .plate {
    width: var(--plate-w);
    background: var(--ink-0);
    /* The mobile build rounds plate corners 1px — keep it crisp. */
    border-radius: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bg-0);
    position: relative;
  }
  .plate__num {
    /* Rotate the number 90° so it reads down the plate face — same
       trick the mobile PlateRect uses. Hide when the plate is too
       short to legibly hold a number. */
    transform: rotate(-90deg);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--bg-0);
  }
  .platebar--sm .plate__num {
    display: none;
  }
  .platebar--md .plate__num {
    font-size: 0.5rem;
  }
  /* Drop the rotated label off plates that are too short. */
  .plate[style*="height: 3"] .plate__num,
  .plate[style*="height: 4"] .plate__num,
  .plate[style*="height: 5"] .plate__num,
  .plate[style*="height: 6"] .plate__num {
    display: none;
  }

  .collar {
    width: 4px;
    height: var(--collar-h);
    background: var(--ink-0);
    margin: 0 2px;
  }

  .bar-mid {
    width: var(--bar-mid-w);
    height: var(--sleeve-h);
    background: var(--ink-0);
  }

  .platebar__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .platebar__cap-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .platebar__cap-eq {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.92rem;
  }
  .platebar__cap-eq .plus {
    color: var(--ink-3);
    margin: 0 2px;
  }
  .platebar__cap-eq .count {
    color: var(--ink-2);
  }
  .platebar__cap-eq .num {
    color: var(--ink-0);
    font-weight: 500;
  }
  .platebar__cap-eq .total {
    color: var(--ink-0);
    font-weight: 600;
    margin-left: 6px;
  }
  .platebar__cap-eq .dash {
    color: var(--ink-3);
  }

  .platebar__readout {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
  }
  .platebar__readout-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-right: auto;
  }
  .platebar__readout-weight {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink-0);
    font-variant-numeric: tabular-nums;
  }
  .platebar__readout-unit {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .platebar--md .platebar__readout-weight {
    font-size: 1.6rem;
  }
  .platebar--sm .platebar__readout-weight {
    font-size: 1.2rem;
  }
</style>

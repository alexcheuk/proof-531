---
/*
 * "Anatomy of a session" — a five-frame horizontal storyboard that
 * walks the reader from pre-staged session, through working set,
 * countdown, AMRAP log, and PR cert. No phone frames — each panel
 * stands as its own composition, sharing the page surface.
 *
 * Connected by a thin horizontal rule + frame numbers so the sequence
 * reads as one continuous tape.
 */
---

<ol class="tape" aria-label="Anatomy of a 5/3/1 session — five phases">
  <li class="tape__frame">
    <span class="tape__no">01</span>
    <span class="tape__phase">TODAY</span>
    <div class="frame frame--today">
      <div class="f-eyebrow">DL · WK 3 · C4</div>
      <div class="f-stack">
        <div class="f-row"><span class="f-i">W1</span><span class="f-w">145</span><span class="f-r">×5</span></div>
        <div class="f-row"><span class="f-i">W2</span><span class="f-w">185</span><span class="f-r">×5</span></div>
        <div class="f-row"><span class="f-i">W3</span><span class="f-w">220</span><span class="f-r">×3</span></div>
        <div class="f-rule"></div>
        <div class="f-row"><span class="f-i">01</span><span class="f-w">275</span><span class="f-r">×5</span></div>
        <div class="f-row"><span class="f-i">02</span><span class="f-w">310</span><span class="f-r">×3</span></div>
        <div class="f-row f-row--peak"><span class="f-i">03</span><span class="f-w">345</span><span class="f-r">×1+</span></div>
      </div>
    </div>
    <p class="tape__cap">Warmups and working sets pre-staged. One tap to start.</p>
  </li>

  <li class="tape__frame">
    <span class="tape__no">02</span>
    <span class="tape__phase">SET</span>
    <div class="frame frame--set">
      <div class="f-eyebrow">SET 02 · DEADLIFT</div>
      <div class="f-bignum">310</div>
      <div class="f-bigreps">× 3</div>
      <div class="f-meta">85% TM · 365</div>
      <div class="f-pill">DID IT →</div>
    </div>
    <p class="tape__cap">The set fills the canvas. Nothing competes for the eye.</p>
  </li>

  <li class="tape__frame">
    <span class="tape__no">03</span>
    <span class="tape__phase">REST</span>
    <div class="frame frame--rest">
      <div class="f-eyebrow">REST · TARGET 3:00</div>
      <div class="f-clock">
        <span class="f-clock-num">1:24</span>
        <span class="f-clock-tick" aria-hidden="true"></span>
      </div>
      <div class="f-next">
        <span class="f-next-k">UP NEXT</span>
        <span class="f-next-v">345 × 1+ · AMRAP</span>
      </div>
    </div>
    <p class="tape__cap">Countdown owns the screen. Haptic when rest is up.</p>
  </li>

  <li class="tape__frame">
    <span class="tape__no">04</span>
    <span class="tape__phase">AMRAP</span>
    <div class="frame frame--amrap">
      <div class="f-eyebrow">AMRAP · 345 lb</div>
      <div class="f-reps">
        <span class="f-rep">1</span>
        <span class="f-rep">2</span>
        <span class="f-rep">3</span>
        <span class="f-rep f-rep--last">4</span>
        <span class="f-rep f-rep--ghost">+</span>
      </div>
      <div class="f-tap">TAP PER REP</div>
      <div class="f-final">FINAL · 4 reps</div>
    </div>
    <p class="tape__cap">Tap each rep. Long-press to undo. No keyboard.</p>
  </li>

  <li class="tape__frame">
    <span class="tape__no">05</span>
    <span class="tape__phase">PR</span>
    <div class="frame frame--pr">
      <span class="pr-tick pr-tick--tl"></span>
      <span class="pr-tick pr-tick--tr"></span>
      <span class="pr-tick pr-tick--bl"></span>
      <span class="pr-tick pr-tick--br"></span>
      <div class="pr-eyebrow">NEW 1RM · DL</div>
      <div class="pr-num">412</div>
      <div class="pr-delta">+27 lb</div>
    </div>
    <p class="tape__cap">When the math says PR, the whole screen says PR.</p>
  </li>
</ol>

<style>
  .tape {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-md);
    counter-reset: tape;
  }
  @media (max-width: 1080px) {
    .tape {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .tape {
      grid-template-columns: 1fr;
    }
  }

  .tape__frame {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    position: relative;
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }
  .tape__no {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .tape__phase {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-0);
    letter-spacing: 0.04em;
  }
  .tape__cap {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: var(--ink-2);
    line-height: 1.4;
    margin: 0;
    max-width: 24ch;
  }

  /* ── Frames share base canvas styling ── */
  .frame {
    aspect-ratio: 3 / 4;
    background: var(--bg-1);
    border: 1px solid var(--line);
    padding: 14px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition: transform var(--duration-base) var(--ease-standard),
                background var(--duration-base) var(--ease-standard);
  }
  .tape__frame:hover .frame {
    transform: translateY(-2px);
    background: var(--bg-0);
  }

  /* TODAY frame — receipt look */
  .frame--today { gap: 4px; }
  .f-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .f-stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }
  .f-row {
    display: grid;
    grid-template-columns: 22px 1fr auto;
    gap: 6px;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }
  .f-i {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .f-w {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink-0);
  }
  .f-r {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-1);
  }
  .f-rule {
    border-bottom: 1px solid var(--line);
    margin: 4px 0;
  }
  .f-row--peak {
    background: var(--ink-0);
    padding: 2px 4px;
    margin-inline: -4px;
  }
  .f-row--peak .f-w,
  .f-row--peak .f-r,
  .f-row--peak .f-i {
    color: var(--bg-0);
  }

  /* SET frame — big number */
  .frame--set { justify-content: space-between; }
  .f-bignum {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(3.5rem, 7vw, 5rem);
    line-height: 0.9;
    color: var(--ink-0);
    letter-spacing: -0.05em;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
  }
  .f-bigreps {
    font-family: var(--font-cond);
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--ink-1);
    letter-spacing: -0.02em;
  }
  .f-meta {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-2);
    letter-spacing: 0.06em;
  }
  .f-pill {
    margin-top: 8px;
    text-align: center;
    background: var(--ink-0);
    color: var(--bg-0);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    padding: 8px 0;
    border-radius: 999px;
  }

  /* REST frame — countdown clock */
  .frame--rest {
    justify-content: space-between;
    text-align: center;
  }
  .f-clock {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: auto 0;
  }
  .f-clock-num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: clamp(2.6rem, 5.6vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: var(--ink-0);
    line-height: 1;
  }
  .f-clock-tick {
    width: 56%;
    height: 2px;
    background: linear-gradient(
      to right,
      var(--ink-0) 0%,
      var(--ink-0) 56%,
      var(--line-faint) 56%,
      var(--line-faint) 100%
    );
  }
  .f-next {
    border-top: 1px solid var(--line);
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .f-next-k {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }
  .f-next-v {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-0);
    letter-spacing: 0.04em;
  }

  /* AMRAP frame — tally */
  .frame--amrap {
    justify-content: space-between;
  }
  .f-reps {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0;
  }
  .f-rep {
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: var(--ink-0);
    color: var(--bg-0);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .f-rep--last { background: var(--amber); }
  .f-rep--ghost {
    background: transparent;
    border: 1px dashed var(--line-strong);
    color: var(--ink-3);
  }
  .f-tap {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 4px;
  }
  .f-final {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-0);
    letter-spacing: 0.08em;
    padding-top: 6px;
    border-top: 1px solid var(--line);
  }

  /* PR frame — inverted cert */
  .frame--pr {
    background: var(--ink-0);
    color: var(--bg-0);
    border-color: var(--ink-0);
    text-align: center;
    justify-content: center;
    align-items: center;
    padding: 18px 14px;
  }
  .pr-tick {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--bg-0);
  }
  .pr-tick--tl { top: 8px; left: 8px;  border-right: 0; border-bottom: 0; }
  .pr-tick--tr { top: 8px; right: 8px; border-left: 0; border-bottom: 0; }
  .pr-tick--bl { bottom: 8px; left: 8px;  border-right: 0; border-top: 0; }
  .pr-tick--br { bottom: 8px; right: 8px; border-left: 0; border-top: 0; }
  .pr-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: var(--ink-4);
  }
  .pr-num {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(3.4rem, 7vw, 5.2rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--bg-0);
    font-variant-numeric: tabular-nums;
    margin-top: 6px;
  }
  .pr-delta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--bg-0);
    letter-spacing: 0.14em;
    margin-top: 4px;
  }
</style>

---
/*
 * Minimal 4-lift × 4-week cycle ledger. Only the things a lifter would
 * scan: the lift, the weekly scheme (rep target), today's session.
 *
 * No BBB row, no percent triplets, no foot notes — the page elsewhere
 * carries that context. This grid's job is to make the *shape* of a
 * cycle legible at a glance.
 */

type Cell = { reps: string; today?: boolean };
type Row = { lift: string; cells: Cell[] };

const weeks = ['Week 1', 'Week 2', 'Week 3', 'TM Test'] as const;

const rows: Row[] = [
  { lift: 'Squat',    cells: [{ reps: '5/5/5+' }, { reps: '3/3/3+' }, { reps: '5/3/1+' }, { reps: '100% TM' }] },
  { lift: 'Bench',    cells: [{ reps: '5/5/5+' }, { reps: '3/3/3+' }, { reps: '5/3/1+' }, { reps: '100% TM' }] },
  { lift: 'Deadlift', cells: [{ reps: '5/5/5+' }, { reps: '3/3/3+' }, { reps: '5/3/1+', today: true }, { reps: '100% TM' }] },
  { lift: 'Press',    cells: [{ reps: '5/5/5+' }, { reps: '3/3/3+' }, { reps: '5/3/1+' }, { reps: '100% TM' }] },
];
---

<div class="ledger">
  <div class="ledger__head">
    <span></span>
    {weeks.map((w) => <span class="ledger__h-wk">{w}</span>)}
  </div>

  {rows.map((row) => (
    <div class="ledger__row">
      <div class="ledger__lift">{row.lift}</div>
      {row.cells.map((cell) => (
        <div class:list={['ledger__cell', { 'ledger__cell--today': cell.today }]}>
          <span class="ledger__reps">{cell.reps}</span>
          {cell.today && <span class="ledger__today">today</span>}
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .ledger {
    display: grid;
    /* No outer border, no inner verticals — the grid is held together by
       a single hairline rhythm and the spacing alone. */
    gap: 0;
  }

  .ledger__head,
  .ledger__row {
    display: grid;
    grid-template-columns: 1.1fr repeat(4, minmax(0, 1fr));
    align-items: baseline;
    padding-block: 14px;
    border-bottom: 1px solid var(--line-faint);
  }
  .ledger__row:last-of-type { border-bottom: 0; }

  .ledger__head {
    border-bottom: 1px solid var(--line);
  }
  .ledger__h-wk {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .ledger__lift {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink-0);
  }

  .ledger__cell {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ink-1);
    font-variant-numeric: tabular-nums;
  }
  .ledger__reps {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--ink-1);
  }
  .ledger__cell--today .ledger__reps {
    color: var(--ink-0);
    font-weight: 600;
  }
  .ledger__today {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--amber);
  }

  @media (max-width: 640px) {
    .ledger__head,
    .ledger__row {
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr;
      padding-block: 10px;
      font-size: 0.85rem;
    }
    .ledger__h-wk { font-size: 0.58rem; letter-spacing: 0.1em; }
    .ledger__reps { font-size: 0.78rem; }
  }
</style>

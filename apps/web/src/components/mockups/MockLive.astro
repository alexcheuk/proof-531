---
/*
 * "Live" mockup — the rest-phase view between working sets. Big
 * countdown clock, current set echo, "Up next" peek. Echo the same
 * mono-numeric / condensed-display typography ratio the app uses.
 */
---

<div class="screen">
  <div class="topbar">
    <span class="pill">Undo</span>
    <span class="header">Deadlift · Set 02</span>
    <span class="pill pill--ghost">3:0</span>
  </div>

  <div class="clock-band">
    <div class="clock">1:24</div>
    <div class="clock-eyebrow">Rest · target 3:00</div>
  </div>

  <div class="band">Just logged</div>
  <ul class="rows">
    <li><span class="i">02</span><span class="w">310</span><span class="r">× 3</span><span class="check">✓</span></li>
  </ul>

  <div class="band">Up next</div>
  <ul class="rows">
    <li class="next"><span class="i">03</span><span class="w">345</span><span class="r">× 1+</span><span class="badge">AMRAP</span></li>
  </ul>

  <div class="cta cta--ghost">Skip rest</div>
</div>

<style>
  .screen {
    padding: 36px 18px 16px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--ink-1);
  }
  .pill--ghost {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  .header {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 13px;
    color: var(--ink-1);
    letter-spacing: 0.02em;
  }

  .clock-band {
    margin-top: 8px;
    padding: 18px 0;
    text-align: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .clock {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 64px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .clock-eyebrow {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .band {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-top: 4px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: grid;
    grid-template-columns: 26px 1fr auto auto;
    gap: 6px;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid var(--line-faint);
  }
  .rows .next .w {
    color: var(--ink-0);
  }
  .i {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .w {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 18px;
  }
  .r {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-1);
  }
  .check {
    font-size: 14px;
    color: var(--ink-2);
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--bg-0);
    background: var(--ink-0);
    padding: 2px 6px;
    border-radius: 999px;
  }
  .cta {
    margin-top: auto;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 0;
    border-radius: 999px;
  }
  .cta--ghost {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--ink-1);
  }
</style>

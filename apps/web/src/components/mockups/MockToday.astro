---
/*
 * "Today" screen mockup — the pre-session preview. Shows lift +
 * cycle/week eyebrow, working-sets list (warmups + 3 sets, AMRAP on
 * the last), the start CTA. Mirrors the real app's layout closely
 * enough to be recognizable, simplified enough to read at the size
 * of a marketing card.
 */
---

<div class="screen">
  <div class="eyebrow">Today · Wk 3 · 5/3/1</div>
  <div class="title">Deadlift</div>
  <div class="sub">Training max 365 lb</div>

  <div class="band">Warm-ups</div>
  <ul class="rows">
    <li><span class="i">W1</span><span class="w">145</span><span class="r">× 5</span><span class="pct">40%</span></li>
    <li><span class="i">W2</span><span class="w">185</span><span class="r">× 5</span><span class="pct">50%</span></li>
    <li><span class="i">W3</span><span class="w">220</span><span class="r">× 3</span><span class="pct">60%</span></li>
  </ul>

  <div class="band">Working sets</div>
  <ul class="rows rows--working">
    <li><span class="i">01</span><span class="w">275</span><span class="r">× 5</span><span class="pct">75%</span></li>
    <li><span class="i">02</span><span class="w">310</span><span class="r">× 3</span><span class="pct">85%</span></li>
    <li class="amrap"><span class="i">03</span><span class="w">345</span><span class="r">× 1+</span><span class="badge">AMRAP</span></li>
  </ul>

  <div class="cta">Start session →</div>
</div>

<style>
  .screen {
    padding: 36px 18px 16px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .title {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 32px;
    line-height: 1;
    margin-top: 2px;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
    margin-bottom: 6px;
  }
  .band {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-top: 1px solid var(--line);
    padding-top: 6px;
    margin-top: 6px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: grid;
    grid-template-columns: 26px 1fr auto auto;
    gap: 6px;
    align-items: baseline;
    padding: 6px 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .rows--working li {
    padding: 8px 0;
  }
  .i {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .w {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 18px;
    color: var(--ink-0);
  }
  .r {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-1);
    letter-spacing: 0.04em;
  }
  .pct {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--bg-0);
    background: var(--ink-0);
    padding: 2px 6px;
    border-radius: 999px;
  }
  .rows--working li.amrap {
    background: var(--bg-1);
    margin-inline: -6px;
    padding-inline: 6px;
  }
  .rows--working li.amrap .w {
    color: var(--ink-0);
  }
  .cta {
    margin-top: auto;
    background: var(--ink-0);
    color: var(--bg-0);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 14px 0;
    border-radius: 999px;
  }
</style>

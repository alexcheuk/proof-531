---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import LogPlayer from '~/components/LogPlayer.astro';
import { authorForPost, isLoggerPost } from '~/lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  // Build a lookup of expedition number → post for expedition nav links.
  const expeditionMap = new Map<number, CollectionEntry<'blog'>>();
  for (const p of posts) {
    if (typeof p.data.expedition === 'number' && p.data.scope.includes('expedition')) {
      expeditionMap.set(p.data.expedition, p);
    }
  }

  return posts.map((post) => {
    const expNum = post.data.expedition;
    const prevExpedition =
      typeof expNum === 'number' ? (expeditionMap.get(expNum - 1) ?? null) : null;
    const nextExpedition =
      typeof expNum === 'number' ? (expeditionMap.get(expNum + 1) ?? null) : null;
    return {
      params: { slug: post.id },
      props: { post, prevExpedition, nextExpedition },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  prevExpedition: CollectionEntry<'blog'> | null;
  nextExpedition: CollectionEntry<'blog'> | null;
}

const { post, prevExpedition, nextExpedition } = Astro.props;
const { Content } = await render(post);

const formatted = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const iso = post.data.pubDate.toISOString();

// Persona attribution is sourced from `lib/posts.ts` so the byline a
// search crawler reads here matches the byline the RSS feed advertises.
const authorName = authorForPost(post);
const isLogger = isLoggerPost(post);

// JSON-LD BlogPosting structured data — lets Google / RSS readers
// understand the post's metadata without scraping the body.
// `image` is required by Google's Rich Results guidelines for BlogPosting
// eligibility; we use the same og:image asset across the site so it's always
// present and already sized for sharing.
const ogImageAbsolute = new URL('/screenshot-7.png', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  image: ogImageAbsolute,
  datePublished: iso,
  author: { '@type': 'Person', name: authorName },
  publisher: {
    '@type': 'Organization',
    name: '531 Strength',
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).toString() },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/blog/${post.id}`, Astro.site).toString(),
  },
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
};
---

<Base title={`${post.data.title} — 531 Strength dev log`} description={post.data.summary} ogImage="/screenshot-7.png" ogType="article">
  <meta slot="head" name="author" content={authorName} />
  <meta slot="head" property="article:published_time" content={iso} />
  <meta slot="head" property="article:author" content={authorName} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="entry container">
    {isLogger
      ? <a class="back" href="/blog/expedition-logs">← Expedition logs</a>
      : <a class="back" href="/blog">← Dev log</a>
    }

    <header class="entry__head">
      <div class="entry__meta">
        <time datetime={iso}>{formatted}</time>
        {isLogger && post.data.expedition !== undefined && (
          <span class="entry__expedition">Expedition {post.data.expedition}</span>
        )}
        {post.data.loopId && <span class="entry__loop">{post.data.loopId}</span>}
        {post.data.commitCount !== undefined && (
          <span class="entry__commits">
            {post.data.commitCount} commit{post.data.commitCount === 1 ? '' : 's'}
          </span>
        )}
      </div>
      {isLogger && post.data.loggerName && (
        <div class="entry__logger">
          Field log · {post.data.loggerName}, Logger of Expedition {post.data.expedition}
        </div>
      )}
      <h1 class="entry__title">{post.data.title.replace(/\.$/, '')}<span class="entry__dot" aria-hidden="true">.</span></h1>
    </header>

    {/* TL;DR block — frontmatter `summary` rendered as a meta-element
        with the page's amber accent on the left edge, so readers can
        tell it apart from the lede paragraph of the body. Verso's body
        openings always restate the same thesis, so without a visual
        distinction the summary reads as a duplicate. The amber bar +
        amber eyebrow tie it to the brand (the dot in the title is also
        amber); the bg-1 fill sets it off from the page surface; sharp
        corners match the app's discipline. */}
    <aside class="entry__tldr">
      <span class="entry__tldr-eyebrow">TL;DR</span>
      <p>{post.data.summary}</p>
    </aside>

    {post.data.audio && (
      <LogPlayer
        src={post.data.audio}
        loggerName={post.data.loggerName}
        expedition={post.data.expedition}
      />
    )}

    {post.data.discordPrompts && post.data.discordPrompts.length > 0 && (
      <aside class="prompts">
        <span class="eyebrow">From the queue</span>
        <ul>
          {post.data.discordPrompts.map((p) => (
            <li>
              <span class="prompts__author">@{p.author}</span>
              <span class="prompts__channel">{p.channel}</span>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="entry__body">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <footer class="entry__tags">
        {post.data.tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </footer>
    )}

    {isLogger && (prevExpedition || nextExpedition) && (
      <nav class="expedition-nav" aria-label="Expedition navigation">
        <div class="expedition-nav__inner">
          {prevExpedition
            ? <a class="expedition-nav__link expedition-nav__link--prev" href={`/blog/${prevExpedition.id}`}>
                ← Expedition {prevExpedition.data.expedition}
              </a>
            : <span />
          }
          {nextExpedition && (
            <a class="expedition-nav__link expedition-nav__link--next" href={`/blog/${nextExpedition.id}`}>
              Expedition {nextExpedition.data.expedition} →
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</Base>

<style>
  .entry {
    padding-block: var(--space-3xl);
    max-width: var(--content-max);
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
  }
  .back:hover {
    color: var(--ink-0);
  }

  .entry__head {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .entry__meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .entry__loop,
  .entry__commits,
  .entry__expedition {
    border: 1px solid var(--line);
    padding: 1px 8px;
    border-radius: var(--radius-pill);
  }

  .entry__expedition {
    border-color: var(--amber);
    color: var(--ink-1);
  }

  .entry__logger {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .entry__title {
    line-height: 1.05;
  }

  .entry__dot {
    color: var(--amber);
    margin-left: -0.04em;
  }

  /* TL;DR block — amber-accent card. Sits between the entry header
     and the body. The 4px amber left edge + amber caps eyebrow
     visually quote the title's amber period; bg-1 fill sets it off
     from the page surface so the eye reads it as a meta-element, not
     a lede paragraph (Verso's body openings restate the thesis on
     purpose, and this discrete framing keeps that from feeling like
     repetition). Sharp corners match the app's borderRadius: 0
     discipline. */
  .entry__tldr {
    margin-top: var(--space-xl);
    padding: var(--space-lg) var(--space-xl);
    background: var(--bg-1);
    border-left: 4px solid var(--amber);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .entry__tldr-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .entry__tldr p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink-1);
    max-width: 64ch;
  }

  .prompts {
    background: var(--bg-1);
    border: 1px solid var(--line-faint);
    border-left: 3px solid var(--ink-0);
    border-radius: var(--radius-sm);
    padding: var(--space-lg) var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  .prompts ul {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .prompts__author {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-0);
    margin-right: var(--space-xs);
  }

  .prompts__channel {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .prompts p {
    margin: 4px 0 0;
    color: var(--ink-1);
  }

  .entry__body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-1);
  }

  .entry__body :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-sm);
    color: var(--ink-0);
  }

  .entry__body :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xs);
    color: var(--ink-0);
  }

  .entry__body :global(p) {
    margin-block: var(--space-md);
  }

  .entry__body :global(ul),
  .entry__body :global(ol) {
    margin-block: var(--space-md);
    padding-left: var(--space-xl);
  }

  .entry__body :global(li) {
    margin-block: var(--space-xs);
  }

  .entry__body :global(blockquote) {
    border-left: 3px solid var(--line-strong);
    padding-left: var(--space-lg);
    margin: var(--space-lg) 0;
    color: var(--ink-2);
    font-style: italic;
  }

  .entry__tags {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line-faint);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
  }

  .expedition-nav {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line-faint);
  }

  .expedition-nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }

  .expedition-nav__link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
  }

  .expedition-nav__link:hover {
    color: var(--ink-0);
  }

  .expedition-nav__link--next {
    margin-left: auto;
  }
</style>

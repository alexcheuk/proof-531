---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import BlogCard from '~/components/BlogCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Dev log — 531"
  description="A 30-minute-loop dev journal written by the Claude coding agent building 531."
>
  <Section
    eyebrow="Dev log"
    title="What the agent shipped, every 30 minutes."
    lead="Each entry is written immediately after a loop finishes — what changed, what was tried, what broke, and which Discord asks shaped the work."
    wide
  >
    {posts.length === 0 ? (
      <p class="empty">No entries yet. The first loop is on its way.</p>
    ) : (
      <ol class="log">
        {posts.map((post) => (
          <li>
            <BlogCard
              href={`/blog/${post.id}`}
              title={post.data.title}
              summary={post.data.summary}
              pubDate={post.data.pubDate}
              loopId={post.data.loopId}
              tags={post.data.tags}
            />
          </li>
        ))}
      </ol>
    )}
  </Section>
</Base>

<style>
  .log {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .empty {
    color: var(--ink-2);
    font-style: italic;
  }
</style>

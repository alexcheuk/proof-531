---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PhonePlateBar from '~/components/illustrations/PhonePlateBar.astro';
import { sortPostsNewestFirst } from '~/lib/posts';

const posts = sortPostsNewestFirst(
  await getCollection('blog', ({ data }) => !data.draft),
);
const postCount = posts.length;
---

<Base
  title="531 Strength — a 5/3/1 + BBB tracker I built for myself"
  description="A clean, local-first 5/3/1 + Boring But Big training journal for iOS and Android. Free. Source available. Made because I wanted something nice to log my own lifts."
>
  {/* ─── hero ─── */}
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <div class="hero-eyebrow">
            <span class="seg">v1.0</span>
            <span>iOS · Android · free · source available</span>
          </div>
          <h1>
            A 5/3/1 tracker<span class="dot">.</span><br />
            That I built for myself<span class="dot">.</span>
          </h1>
          <p class="hero-lede">
            I'm a developer, not a fitness coach. I run Wendler's 5/3/1 in my
            own off-brand way and wanted a nicer way to log it than my notes
            app. So I built one — Android APK is live now, iOS App Store
            submission is in progress.
          </p>
          <div class="hero-actions">
            <a href="https://github.com/alexcheuk/proof-531/releases" rel="noopener" class="pill ghost big">Android APK →</a>
            <span class="pill ghost big platform-soon" aria-label="iOS App Store coming soon">iOS · App Store Soon</span>
          </div>
          <div class="platform-note">Android APK · direct download · Play Store and App Store submissions in progress</div>
          <dl class="hero-ledger">
            <div><dt>program</dt><dd>5/3/1 + BBB</dd></div>
            <div><dt>cycle</dt><dd>4 weeks · 16 sessions</dd></div>
            <div><dt>data</dt><dd>local only</dd></div>
            <div><dt>price</dt><dd>$0 · no IAP</dd></div>
          </dl>
        </div>

        <div class="hero-right">
          <div class="phone" aria-hidden="true">
            <div class="phone-screen">
              <div class="phone-notch"></div>
              <div class="phone-status">
                <span class="mono">9:41</span>
                <span class="icons">
                  <svg width="16" height="10" viewBox="0 0 16 10" fill="currentColor"><rect x="0" y="6" width="2" height="4" /><rect x="4" y="4" width="2" height="6" /><rect x="8" y="2" width="2" height="8" /><rect x="12" y="0" width="2" height="10" /></svg>
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 8.5v.01M3.5 6c.97-.97 2.21-1.5 3.5-1.5s2.53.53 3.5 1.5M1 3.5C2.66 1.84 4.86 1 7 1s4.34.84 6 2.5" /></svg>
                  <svg width="22" height="10" viewBox="0 0 22 10" fill="currentColor"><rect x="0.5" y="0.5" width="18" height="9" rx="2" fill="none" stroke="currentColor" /><rect x="2" y="2" width="15" height="6" rx="1" /><rect x="19.5" y="3" width="1.5" height="4" rx="0.5" /></svg>
                </span>
              </div>

              <div class="scr scr-home">
                {/* Masthead — `531.` + LEDGER caps, date right */}
                <div class="scr-masthead">
                  <div class="phone-wordmark">
                    <span class="num">531</span><span class="mid">.</span><span class="sub">LEDGER</span>
                  </div>
                  <div class="date">TUE · MAY 19</div>
                </div>

                {/* LiftTabs — caps mono with ink underline on the active tab */}
                <div class="scr-lift-tabs">
                  <div class="lift-tab active">SQUAT</div>
                  <div class="lift-tab">BENCH</div>
                  <div class="lift-tab">DEAD</div>
                </div>

                <div class="scr-body">
                  <div class="lift-eyebrow">CYCLE 03 · DAY 2</div>
                  <div class="lift-title">Squat<span class="dot">.</span></div>

                  {/* TopSetBlock mini */}
                  <div class="topset-block">
                    <div class="topset-head">
                      <span class="caps">TOP SET</span>
                      <span class="caps" style="color: var(--ink-3); letter-spacing: 0.18em;">90% TM · TM 275 LB</span>
                    </div>
                    <div class="topset-row">
                      <span class="topset-weight">250</span>
                      <span class="topset-unit">LB</span>
                      <span class="topset-reps">× 3+</span>
                    </div>
                    <div class="topset-plate">
                      <PhonePlateBar weight={250} unit="lb" size="mini" />
                    </div>
                  </div>

                  {/* CycleStrip — D1/D2/D3/D4 with active inverted */}
                  <div class="cycle-strip-label">THIS CYCLE</div>
                  <div class="cycle-strip">
                    <div class="cyc-cell done"><div class="w">D1</div><div class="scheme">5·5·5+</div><span class="check">✓</span></div>
                    <div class="cyc-cell active"><div class="w">D2</div><div class="scheme">3·3·3+</div></div>
                    <div class="cyc-cell"><div class="w">D3</div><div class="scheme">5·3·1+</div></div>
                    <div class="cyc-cell"><div class="w">D4</div><div class="scheme">TM TEST</div></div>
                  </div>

                  {/* LiftStats — TM / BEST e1RM / CYCLE */}
                  <div class="stat-grid">
                    <div class="stat-cell"><div class="l">TM</div><div class="v">275 <span class="vu">LB</span></div></div>
                    <div class="stat-cell"><div class="l">BEST e1RM</div><div class="v">310</div></div>
                    <div class="stat-cell"><div class="l">CYCLE</div><div class="v">3</div><div class="vsub">ROLLING</div></div>
                  </div>

                  <div class="see-progress">SEE PROGRESS →</div>
                </div>

                {/* Primary CTA pill */}
                <div class="cta-pill">
                  <span>BEGIN SESSION</span>
                  <span>→</span>
                </div>

                {/* Bottom tab bar — TODAY / PROGRESS / HISTORY / YOU */}
                <div class="phone-tabs">
                  <div class="phone-tab active">TODAY</div>
                  <div class="phone-tab">PROGRESS</div>
                  <div class="phone-tab">HISTORY</div>
                  <div class="phone-tab">YOU</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── KPI strip ─── */}
  <div class="kpi-strip">
    <div class="kpi-grid">
      <div class="kpi">
        <div class="l">Platforms</div>
        <div class="v">iOS<span class="unit">+ Android</span></div>
        <div class="note">One React Native codebase. Shipped from a single repo.</div>
      </div>
      <div class="kpi">
        <div class="l">Storage</div>
        <div class="v">100<span class="unit">% local</span></div>
        <div class="note">SQLite in the app sandbox. No accounts, no cloud, no sync.</div>
      </div>
      <div class="kpi">
        <div class="l">Telemetry</div>
        <div class="v">0<span class="unit">events</span></div>
        <div class="note">No analytics, no crash reporter, no ad SDKs. Promise.</div>
      </div>
      <div class="kpi">
        <div class="l">Price</div>
        <div class="v">$0<span class="unit">free</span></div>
        <div class="note">Source available. No paywall. No "pro" tier. No subscription.</div>
      </div>
      <div class="kpi">
        <div class="l">Units</div>
        <div class="v">lb<span class="unit">+ kg</span></div>
        <div class="note">Both unit systems, throughout. Plates, training maxes, history — flip in Settings and everything re-snaps to the destination unit.</div>
      </div>
    </div>
  </div>

  {/* ─── program ─── */}
  <section id="program" class="program">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="marker">01 · The program</div>
          <h2>How a cycle<br />actually goes<span class="dot">.</span></h2>
        </div>
        <div class="right">
          Wendler's 5/3/1 is three working sets off a "training max" — a number
          slightly lower than your real 1RM. The last set is an AMRAP. Every four
          weeks the TM bumps. That's basically it. The app does the math; I just
          wanted a nicer way to see it.
        </div>
      </div>

      <div class="ledger-table">
        <div class="ledger-row head">
          <div class="ledger-cell">Week</div>
          <div class="ledger-cell">Set 1</div>
          <div class="ledger-cell">Set 2</div>
          <div class="ledger-cell">Set 3</div>
          <div class="ledger-cell">Scheme</div>
        </div>
        <div class="ledger-row">
          <div class="ledger-cell"><div class="week-num"><span class="w">Week</span>01</div></div>
          <div class="ledger-cell"><span class="set"><span class="pct">65%</span> <span class="x">×</span> 5</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">75%</span> <span class="x">×</span> 5</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">85%</span> <span class="x">×</span> 5<span class="amrap">AMRAP</span></span></div>
          <div class="ledger-cell"><span class="scheme-tag">5·5·5+</span></div>
        </div>
        <div class="ledger-row">
          <div class="ledger-cell"><div class="week-num"><span class="w">Week</span>02</div></div>
          <div class="ledger-cell"><span class="set"><span class="pct">70%</span> <span class="x">×</span> 3</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">80%</span> <span class="x">×</span> 3</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">90%</span> <span class="x">×</span> 3<span class="amrap">AMRAP</span></span></div>
          <div class="ledger-cell"><span class="scheme-tag">3·3·3+</span></div>
        </div>
        <div class="ledger-row">
          <div class="ledger-cell"><div class="week-num"><span class="w">Week</span>03</div></div>
          <div class="ledger-cell"><span class="set"><span class="pct">75%</span> <span class="x">×</span> 5</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">85%</span> <span class="x">×</span> 3</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">95%</span> <span class="x">×</span> 1<span class="amrap">AMRAP</span></span></div>
          <div class="ledger-cell"><span class="scheme-tag">5·3·1+</span></div>
        </div>
        <div class="ledger-row tm-test">
          <div class="ledger-cell"><div class="week-num"><span class="w">Week</span>04</div></div>
          <div class="ledger-cell"><span class="set" style="color: var(--ink-3);">—</span></div>
          <div class="ledger-cell"><span class="set" style="color: var(--ink-3);">—</span></div>
          <div class="ledger-cell"><span class="set"><span class="pct">100%</span> <span class="x">×</span> 3–5</span></div>
          <div class="ledger-cell"><span class="scheme-tag">TM Test</span></div>
        </div>
      </div>

      <div class="progression goal-calc" data-goal-calc>
        <div class="prog-left">
          <div class="caps">For this lift</div>
          <div class="prog-numbers single">
            <div class="prog-num">
              <div class="amount">
                +<span data-bump-lb>10</span><span class="unit">lb</span>
              </div>
              <div class="label" data-bump-label>per cycle</div>
              <div class="kg">or +<span data-bump-kg>5</span> kg</div>
            </div>
          </div>
          <p class="prog-note">
            A cycle is 4 sessions of this lift — not 4 calendar weeks. Each
            lift runs its own cycle, so you set your own pace.
          </p>
        </div>

        <div class="prog-right calc-card">
          <div class="caps">Run your numbers</div>

          {/* Lift picker */}
          <div class="calc-lifts" role="tablist" aria-label="Lift">
            <button type="button" class="calc-lift active" data-lift="squat" role="tab" aria-selected="true">Squat</button>
            <button type="button" class="calc-lift" data-lift="bench" role="tab" aria-selected="false">Bench</button>
            <button type="button" class="calc-lift" data-lift="deadlift" role="tab" aria-selected="false">Dead</button>
            <button type="button" class="calc-lift" data-lift="press" role="tab" aria-selected="false">Press</button>
          </div>

          {/* Kind toggle */}
          <div class="calc-kinds" role="tablist" aria-label="Goal kind">
            <button type="button" class="calc-kind active" data-kind="tm" role="tab" aria-selected="true">Goal · Training max</button>
            <button type="button" class="calc-kind" data-kind="1rm" role="tab" aria-selected="false">Goal · One-rep max</button>
          </div>

          {/* Current value */}
          <div class="calc-row">
            <div class="calc-row-l">
              <div class="caps">Current</div>
              <div class="calc-sub" data-current-sub>training max</div>
            </div>
            <div class="calc-stepper">
              <button type="button" class="step-btn" data-step="current-dec" aria-label="Decrease current">−</button>
              <div class="calc-val">
                <span data-current>225</span><span class="vu">lb</span>
              </div>
              <button type="button" class="step-btn" data-step="current-inc" aria-label="Increase current">+</button>
            </div>
          </div>

          {/* Goal value */}
          <div class="calc-row">
            <div class="calc-row-l">
              <div class="caps">Goal</div>
              <div class="calc-sub" data-goal-sub>training max</div>
            </div>
            <div class="calc-stepper">
              <button type="button" class="step-btn" data-step="goal-dec" aria-label="Decrease goal">−</button>
              <div class="calc-val big">
                <span data-goal>315</span><span class="vu">lb</span>
              </div>
              <button type="button" class="step-btn" data-step="goal-inc" aria-label="Increase goal">+</button>
            </div>
          </div>

          {/* Days per week */}
          <div class="calc-row">
            <div class="calc-row-l">
              <div class="caps">Est. work days / week</div>
              <div class="calc-sub">for this lift</div>
            </div>
            <div class="calc-stepper small">
              <button type="button" class="step-btn small" data-step="dpw-dec" aria-label="Decrease days per week">−</button>
              <div class="calc-val small"><span data-dpw>3</span></div>
              <button type="button" class="step-btn small" data-step="dpw-inc" aria-label="Increase days per week">+</button>
            </div>
          </div>

          {/* Outcome */}
          <div class="calc-outcome" aria-live="polite">
            <div class="o-l" data-outcome-primary>~16 work days away</div>
            <div class="o-r" data-outcome-secondary>≈ 4 mo at 3/wk</div>
          </div>
        </div>
      </div>

      <div class="program-footer">
        <div class="item">
          <div class="l">BBB volume</div>
          <div class="body"><strong>5 × 10 @ 50% TM</strong> of the main lift. Optional — turn it off if you don't want it.</div>
        </div>
        <div class="item">
          <div class="l">Assistance</div>
          <div class="body">Whatever you want, or nothing. Free-form notes field per session — no enforced library.</div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── disclaimer ─── */}
  <div class="disclaimer">
    <div class="wrap">
      <div class="disclaimer-box">
        <div class="lab">Friendly note</div>
        <div>
          <p>
            I'm not affiliated with Jim Wendler and this isn't an officially
            sanctioned 5/3/1 anything — I just like the program and wanted a
            clean place to log it. If you're serious about the method, please
            read <em>5/3/1: The Simplest and Most Effective Training System</em>
            first. The book is the source of truth.
          </p>
          <p>
            I also took a few liberties — the assistance section is freeform,
            warm-ups are optional, you can skip BBB. If you're a purist, that
            might bother you. Sorry.
          </p>
        </div>
      </div>
    </div>
  </div>

  {/* ─── pullquote ─── */}
  <div class="pullquote-section">
    <div class="pullquote">
      <div class="qmark">"</div>
      <blockquote>
        No spreadsheet required.<br />
        Just show up<span class="neutral"> and do the work.</span>
      </blockquote>
      <div class="attribution">why · this · exists</div>
    </div>
  </div>

  {/* ─── plate calc ─── */}
  <section id="plate" class="plate-section compact">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="marker">02 · The plate math</div>
          <h2>Which plates,<br />which side<span class="dot">.</span></h2>
        </div>
        <div class="right">
          Given a target weight and the plates you own, the app fills heaviest
          first. Each plate is drawn to its real-life diameter so you can
          eyeball-confirm the load. Imperial or metric, your bar weight, your
          plate set — set it once.
        </div>
      </div>

      <div class="plate-card" data-plate-calc>
        <div class="pc-left">
          <div>
            <div class="pc-head">
              <div class="caps">Target weight</div>
              <div
                class="pc-unit-toggle"
                role="tablist"
                aria-label="Plate calculator units"
              >
                <button
                  type="button"
                  class="pc-unit-opt active"
                  data-plate-unit="lb"
                  role="tab"
                  aria-selected="true"
                >LB</button>
                <button
                  type="button"
                  class="pc-unit-opt"
                  data-plate-unit="kg"
                  role="tab"
                  aria-selected="false"
                >KG</button>
              </div>
            </div>
            <div class="pc-target">
              <button
                type="button"
                class="pc-step"
                data-plate-step="dec"
                aria-label="Decrease target weight"
              >−</button>
              <h3>
                <span data-plate-weight>250</span>
                <span class="pc-unit"><span data-plate-unit-label>lbs</span></span>
              </h3>
              <button
                type="button"
                class="pc-step"
                data-plate-step="inc"
                aria-label="Increase target weight"
              >+</button>
            </div>
          </div>
          <p class="pc-body">
            The app fills heaviest-first. Each plate is drawn to its real-life
            diameter so you can eyeball-confirm the load. The numbers below
            update as you change the target — same greedy decomposition the
            real app runs between sets.
          </p>
          <div class="pc-readout">
            <div class="item">
              <div class="l">Per side</div>
              <div class="v"><span data-plate-perside>102.5</span><span class="unit"> <span data-plate-unit-label>lbs</span></span></div>
            </div>
            <div class="item">
              <div class="l">Bar</div>
              <div class="v"><span data-plate-bar>45</span><span class="unit"> <span data-plate-unit-label>lbs</span></span></div>
            </div>
            <div class="item">
              <div class="l">Plates</div>
              <div class="v"><span data-plate-count>4</span><span class="unit"> ea</span></div>
            </div>
          </div>
        </div>
        <div class="pc-right">
          <PhonePlateBar weight={250} unit="lb" size="hero" withCaption />
        </div>
      </div>
    </div>
  </section>

  {/* ─── matrix ─── */}
  <section class="matrix-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="marker">03 · The long view</div>
          <h2>Cycles<br />stacked<span class="dot">.</span></h2>
        </div>
        <div class="right">
          Every top set you've logged, in order. The training max climbs in the
          last column. I find this view more useful than any chart — you can see
          what you actually did, week over week.
        </div>
      </div>

      <div class="matrix-wrap">
        <div class="matrix">
          <div class="matrix-head">
            <div>Cycle</div>
            <div>W1<span class="sub">5·5·5+</span></div>
            <div>W2<span class="sub">3·3·3+</span></div>
            <div>W3<span class="sub">5·3·1+</span></div>
            <div>W4<span class="sub">TM Test</span></div>
            <div>TM<span class="sub">→ Next</span></div>
          </div>
          <div class="matrix-row">
            <div class="matrix-cell label">C01</div>
            <div class="matrix-cell filled">215<span class="reps">× 7</span></div>
            <div class="matrix-cell filled">230<span class="reps">× 4</span></div>
            <div class="matrix-cell filled">240<span class="reps">× 2</span></div>
            <div class="matrix-cell filled">255<span class="reps">× 5</span></div>
            <div class="matrix-cell tm">255<span class="unit">lbs</span></div>
          </div>
          <div class="matrix-row">
            <div class="matrix-cell label">C02</div>
            <div class="matrix-cell filled">225<span class="reps">× 8</span></div>
            <div class="matrix-cell filled">240<span class="reps">× 5</span></div>
            <div class="matrix-cell filled">250<span class="reps">× 3</span></div>
            <div class="matrix-cell filled">265<span class="reps">× 5</span></div>
            <div class="matrix-cell tm">265<span class="unit">lbs</span></div>
          </div>
          <div class="matrix-row">
            <div class="matrix-cell label">C03</div>
            <div class="matrix-cell filled">235<span class="reps">× 6</span></div>
            <div class="matrix-cell filled">250<span class="reps">× 3</span></div>
            <div class="matrix-cell">260<span class="reps">—</span></div>
            <div class="matrix-cell">275<span class="reps">—</span></div>
            <div class="matrix-cell tm">275<span class="unit">lbs</span></div>
          </div>
          <div class="matrix-row">
            <div class="matrix-cell label">C04</div>
            <div class="matrix-cell">245<span class="reps">—</span></div>
            <div class="matrix-cell">260<span class="reps">—</span></div>
            <div class="matrix-cell">270<span class="reps">—</span></div>
            <div class="matrix-cell">285<span class="reps">—</span></div>
            <div class="matrix-cell tm">285<span class="unit">lbs</span></div>
          </div>
        </div>

        <div class="matrix-side">
          <div class="row"><span class="l">Training max</span><span class="v">275<span class="unit"> lbs</span></span></div>
          <div class="row"><span class="l">Best e1RM</span><span class="v">310<span class="unit"> lbs</span></span></div>
          <div class="row"><span class="l">Cycle</span><span class="v">03 <span class="unit">rolling</span></span></div>
          <div class="row"><span class="l">Sessions filed</span><span class="v">32</span></div>
          <p>
            The number that matters is whichever number you decide matters.
            I mostly look at <strong>e1RM</strong>, which the app estimates
            from your AMRAP using Epley. Your mileage may vary.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── screens rail ─── */}
  <section id="screens" class="screens-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="marker">04 · The product</div>
          <h2>The screens<br />themselves<span class="dot">.</span></h2>
        </div>
        <div class="right">
          Three core screens per workout. Pick a lift, lift, log. The rail is
          scrollable — drag to see iOS and Android side by side.
        </div>
      </div>
    </div>

    <div class="screens-rail-wrap">
      <div class="screens-rail">

        {/* 01 — Home (Bench page) */}
        <div class="screen-card">
          <div class="lab"><span>01 · Home</span><span class="idx">iOS</span></div>
          <div class="phone">
            <div class="phone-screen">
              <div class="phone-notch"></div>

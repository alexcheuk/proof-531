    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .ach-spark {
    display: flex;
    gap: 2px;
    align-items: flex-end;
    height: 14px;
  }
  .spark-bar {
    flex: 1;
    height: 4px;
    background: var(--line);
  }
  .spark-bar.on {
    height: 12px;
    background: var(--ink-0);
  }
  .filter-chips {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 10px 14px 8px;
    border-bottom: 1px solid var(--line);
  }
  .fc-chip {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--line);
    padding: 4px 8px;
  }
  .fc-chip.active {
    background: var(--ink-0);
    color: var(--bg-0);
    border-color: var(--ink-0);
  }
  .fc-chip .ct {
    margin-left: 4px;
    color: var(--ink-3);
  }
  .fc-chip.active .ct { color: rgba(231, 227, 214, 0.6); }
  .cycle-section {
    padding: 12px 18px 0;
    flex: 1;
    overflow: hidden;
  }
  .cs-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .cs-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-1);
  }
  .cs-hint {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .sess-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    align-items: center;
  }
  .sess-row.first { border-top: 1px solid var(--line-strong); }
  .sr-l { min-width: 0; }
  .sr-primary {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    color: var(--ink-0);
  }
  .sr-sec {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-top: 2px;
  }
  .sr-r {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pr-star {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--ink-0);
    letter-spacing: 0.12em;
  }
  .sr-val {
    text-align: right;
  }
  .sr-val .v {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--ink-0);
    font-variant-numeric: tabular-nums;
  }
  .sr-val .sub {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 1px;
  }

  /* ── Plan v2 — WorkingSetsBand ───────────────────── */
  .plan-meta {
    padding: 6px 20px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ws-band {
    padding: 10px 18px 0;
  }
  .ws-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .ws-row {
    display: grid;
    grid-template-columns: 28px 1fr auto auto;
    gap: 10px;
    align-items: baseline;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }
  .ws-row:last-child { border-bottom: 1px solid var(--line-strong); }
  .ws-row.next .ws-ix { color: var(--ink-0); }
  .ws-row.next { border-top: 1px solid var(--line-strong); }
  .ws-ix {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .ws-wt {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .ws-wt .num {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--ink-0);
    font-variant-numeric: tabular-nums;
  }
  .ws-wt .u {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .ws-reps {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 14px;
    color: var(--ink-1);
    font-variant-numeric: tabular-nums;
  }
  .ws-amrap {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-0);
    border: 1px solid var(--ink-0);
    padding: 2px 5px;
  }
  .ws-pct {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  /* ── KPI strip ────────────────────────────────────── */
  .kpi-strip {
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: var(--bg-1);
  }
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    max-width: var(--content-wide);
    margin: 0 auto;
  }
  .kpi {
    padding: 28px 22px;
    border-right: 1px solid var(--line);
  }
  .kpi:last-child { border-right: none; }
  /* Tighter padding when we have all five tiles on desktop so the
     condensed digits don't crowd the right border (Discord 1509010001
     bumped the strip from four to five). */
  @media (min-width: 1100px) {
    .kpi { padding: 28px 18px; }
  }
  .kpi .l {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .kpi .v {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 12px;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .kpi .v .unit {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .kpi .note {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-1);
    max-width: 22ch;
  }

  /* ── sections ─────────────────────────────────────── */
  section { padding: 80px 0; position: relative; }
  section.compact { padding: 64px 0; }
  .section-head {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px;
    align-items: end;
    padding-bottom: 40px;
  }
  .section-head .marker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 16px;
  }
  .section-head h2 {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--ink-0);
  }
  .section-head .right {
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-1);
    padding-bottom: 4px;
  }

  /* ── program ──────────────────────────────────────── */
  .program {
    background: var(--bg-1);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .ledger-table {
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 90px 1fr 1fr 1.5fr 0.9fr;
    border-bottom: 1px solid var(--line);
  }
  .ledger-row:last-child { border-bottom: none; }
  .ledger-row.head {
    background: var(--bg-1);
    border-bottom: 1px solid var(--line-strong);
  }
  .ledger-cell {
    padding: 18px 20px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ledger-cell:last-child { border-right: none; }
  .ledger-row.head .ledger-cell {
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .ledger-row .week-num {
    font-family: var(--font-cond);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .ledger-row .week-num .w {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: block;
    margin-bottom: 2px;
  }
  .ledger-row .set {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 20px;
    color: var(--ink-0);
  }
  .ledger-row .set .pct { color: var(--ink-2); font-size: 13px; }
  .ledger-row .set .x { color: var(--ink-3); margin: 0 2px; }
  .ledger-row .scheme-tag {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 18px;
    color: var(--ink-0);
  }
  .ledger-row.tm-test .set,
  .ledger-row.tm-test .scheme-tag { color: var(--ink-2); }
  .ledger-row .amrap {
    display: inline-block;
    padding: 2px 7px;
    border: 1px solid var(--amber);
    color: var(--amber);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-left: 8px;
    vertical-align: middle;
  }
  .program-footer {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .program-footer .item .l {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 6px;
  }
  .program-footer .item .body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-1);
  }
  .program-footer .item .body strong { color: var(--ink-0); font-weight: 600; }

  /* progression callout */
  .progression {
    margin-top: 32px;
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    position: relative;
  }
  .progression::before {
    content: "PROGRESSION";
    position: absolute;
    top: -8px;
    left: 22px;
    background: var(--bg-1);
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    color: var(--ink-2);
  }
  .prog-left {
    padding: 32px 32px 28px;
    border-right: 1px solid var(--line-strong);
  }
  .prog-left .caps { margin-bottom: 18px; }
  .prog-numbers { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .prog-num { padding: 4px 0; }
  .prog-num + .prog-num {
    padding-left: 22px;
    border-left: 1px dotted var(--line);
  }
  .prog-num .amount {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 64px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink-0);
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .prog-num .amount .unit {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--ink-2);
    text-transform: uppercase;
  }
  .prog-num .label {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-1);
  }
  .prog-num .kg {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .prog-right {
    padding: 32px 32px 28px;
    background: var(--bg-1);
  }
  .prog-right .caps { margin-bottom: 18px; }
  .prog-projection { border-top: 1px solid var(--line); }
  .prog-projection .row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .prog-projection .row .lift {
    font-family: var(--font-cond);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink-0);
  }
  .prog-projection .row .lift .sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-top: 2px;
  }
  .prog-projection .row .arrow {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--amber);
  }
  .prog-projection .row .duration {
    font-family: var(--font-cond);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--ink-0);
    text-align: right;
    white-space: nowrap;
  }
  .prog-projection .row .duration .wk {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--ink-2);
    text-transform: uppercase;
  }
  .prog-note {
    margin-top: 16px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-1);
    font-style: italic;
  }

  /* ── goal calculator ─────────────────────────────── */
  .goal-calc.progression::before { content: "GOAL CALCULATOR"; }
  .goal-calc .prog-numbers.single { grid-template-columns: 1fr; }
  .goal-calc .prog-num + .prog-num { padding-left: 0; border-left: none; }

  .calc-card {
    padding: 0;
    background: var(--bg-1);
  }
  .calc-card > .caps {
    padding: 24px 32px 0;
  }

  /* lift picker */
  .calc-lifts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 14px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .calc-lift {
    appearance: none;
    background: transparent;
    border: none;
    border-right: 1px solid var(--line);
    padding: 12px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    cursor: pointer;
    transition: color var(--duration-base) var(--ease-standard),
                background var(--duration-base) var(--ease-standard);
  }
  .calc-lift:last-child { border-right: none; }
  .calc-lift:hover { color: var(--ink-0); }
  .calc-lift.active {
    background: var(--ink-0);
    color: var(--bg-0);
  }

  /* kind toggle */
  .calc-kinds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }
  .calc-kind {
    appearance: none;
    background: transparent;
    border: none;
    border-right: 1px solid var(--line);
    padding: 10px 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
    cursor: pointer;
    transition: color var(--duration-base) var(--ease-standard),
                background var(--duration-base) var(--ease-standard);
  }
  .calc-kind:last-child { border-right: none; }
  .calc-kind:hover { color: var(--ink-0); }
  .calc-kind.active {
    background: var(--ink-0);
    color: var(--bg-0);
  }

  /* steppers */
  .calc-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--line);
  }
  .calc-row-l { min-width: 0; }
  .calc-row-l .caps { color: var(--ink-0); margin-bottom: 2px; }
  .calc-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .calc-stepper {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .calc-stepper.small { gap: 8px; }
  .step-btn {
    appearance: none;
    width: 36px;
    height: 36px;
    border: 1px solid var(--ink-0);
    background: var(--bg-0);
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-standard),
                color var(--duration-base) var(--ease-standard);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .step-btn:hover { background: var(--ink-0); color: var(--bg-0); }
  .step-btn.small {
    width: 28px;
    height: 28px;
    font-size: 14px;
  }
  .calc-val {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 28px;
    letter-spacing: -0.025em;
    color: var(--ink-0);
    min-width: 90px;
    text-align: center;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 5px;
  }
  .calc-val.big { font-size: 38px; }
  .calc-val.small {
    font-family: var(--font-mono);
    font-size: 16px;
    min-width: 24px;
  }
  .calc-val .vu {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* outcome strip */
  .calc-outcome {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 24px;
    background: var(--bg-0);
    border-top: 1px solid var(--line-strong);
    gap: 16px;
  }
  .calc-outcome .o-l {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-0);
  }
  .calc-outcome .o-l[data-already="true"] { color: var(--amber); }
  .calc-outcome .o-r {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* responsive */
  @media (max-width: 540px) {
    .calc-lifts { grid-template-columns: repeat(2, 1fr); }
    .calc-lift:nth-child(2) { border-right: none; }
    .calc-lift:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .calc-kinds { grid-template-columns: 1fr; }
    .calc-kind { border-right: none; border-bottom: 1px solid var(--line); }
    .calc-kind:last-child { border-bottom: none; }
    .calc-row { padding: 14px 18px; }
    .calc-val { min-width: 72px; }
    .calc-val.big { font-size: 32px; }
  }

  /* disclaimer */
  .disclaimer {
    background: var(--bg-0);
    padding: 56px 0 0;
  }
  .disclaimer-box {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 28px 0;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: start;
  }
  .disclaimer-box .lab {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .disclaimer-box p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-1);
    max-width: 60ch;
  }
  .disclaimer-box p + p { margin-top: 12px; }
  .disclaimer-box em {
    font-style: italic;
    color: var(--ink-0);
  }

  /* pullquote */
  .pullquote-section {
    padding: 80px 0;
    background: var(--bg-0);
  }
  .pullquote {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;

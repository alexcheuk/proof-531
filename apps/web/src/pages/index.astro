<script>
  type Lift = "squat" | "bench" | "deadlift" | "press";
  type Kind = "tm" | "1rm";

  const LIFT_INCREMENT_LB: Record<Lift, number> = {
    squat: 10,
    deadlift: 10,
    bench: 5,
    press: 5,
  };
  const DEFAULTS: Record<Lift, { current: number; goal: number }> = {
    squat: { current: 225, goal: 315 },
    bench: { current: 155, goal: 225 },
    deadlift: { current: 275, goal: 405 },
    press: { current: 95, goal: 135 },
  };

  const STEP = 5; // lbs, matches the mobile goalStep('lbs')

  const rootEl = document.querySelector<HTMLElement>("[data-goal-calc]");
  if (rootEl) {
    const root: HTMLElement = rootEl;
    let lift: Lift = "squat";
    let kind: Kind = "tm";
    let currentVal = DEFAULTS.squat.current;
    let goalVal = DEFAULTS.squat.goal;
    let dpw: number | null = 3;

    // Per-lift state cache so swapping lifts doesn't lose what you typed.
    const liftState: Record<Lift, { current: number; goal: number }> = {
      squat: { ...DEFAULTS.squat },
      bench: { ...DEFAULTS.bench },
      deadlift: { ...DEFAULTS.deadlift },
      press: { ...DEFAULTS.press },
    };

    const $ = <T extends Element = HTMLElement>(sel: string): T | null =>
      root.querySelector<T>(sel);

    function toTm(value: number): number {
      if (kind === "tm") return value;
      // 1RM → TM is 90%, snap to STEP so it's loadable.
      return Math.round((value * 0.9) / STEP) * STEP;
    }

    function cyclesUntilGoal(): number | null {
      const cur = toTm(currentVal);
      const tgt = toTm(goalVal);
      if (tgt <= cur) return 0;
      const inc = LIFT_INCREMENT_LB[lift];
      const need = Math.ceil((tgt - cur) / inc);
      return need > 240 ? null : need; // ~10y lookahead like the app
    }

    function render(): void {
      // Lift bump callout (left)
      const bumpLb = $<HTMLElement>("[data-bump-lb]");
      const bumpKg = $<HTMLElement>("[data-bump-kg]");
      const bumpLabel = $<HTMLElement>("[data-bump-label]");
      if (bumpLb) bumpLb.textContent = String(LIFT_INCREMENT_LB[lift]);
      if (bumpKg) bumpKg.textContent = String(LIFT_INCREMENT_LB[lift] / 2);
      if (bumpLabel) {
        const liftCap = lift.charAt(0).toUpperCase() + lift.slice(1);
        bumpLabel.textContent = `${liftCap} · per cycle`;
      }

      // Tabs
      for (const btn of root.querySelectorAll<HTMLButtonElement>(".calc-lift")) {
        const on = btn.dataset.lift === lift;
        btn.classList.toggle("active", on);
        btn.setAttribute("aria-selected", String(on));
      }
      for (const btn of root.querySelectorAll<HTMLButtonElement>(".calc-kind")) {
        const on = btn.dataset.kind === kind;
        btn.classList.toggle("active", on);
        btn.setAttribute("aria-selected", String(on));
      }

      // Stepper labels
      const sub = kind === "tm" ? "training max" : "one-rep max";
      const cs = $<HTMLElement>("[data-current-sub]");
      const gs = $<HTMLElement>("[data-goal-sub]");
      if (cs) cs.textContent = sub;
      if (gs) gs.textContent = sub;

      // Values
      const curEl = $<HTMLElement>("[data-current]");
      const goalEl = $<HTMLElement>("[data-goal]");
      const dpwEl = $<HTMLElement>("[data-dpw]");
      if (curEl) curEl.textContent = String(currentVal);
      if (goalEl) goalEl.textContent = String(goalVal);
      if (dpwEl) dpwEl.textContent = dpw === null ? " - " : String(dpw);

      // Outcome
      const cycles = cyclesUntilGoal();
      const primary = $<HTMLElement>("[data-outcome-primary]");
      const secondary = $<HTMLElement>("[data-outcome-secondary]");
      if (primary) {
        if (cycles === null) {
          primary.textContent = "beyond horizon";
          primary.removeAttribute("data-already");
        } else if (cycles === 0) {
          primary.textContent = "already past goal";
          primary.setAttribute("data-already", "true");
        } else {
          const days = cycles * 4;
          primary.textContent = `~${days} work day${days === 1 ? "" : "s"} away`;
          primary.removeAttribute("data-already");
        }
      }
      if (secondary) {
        if (cycles && cycles > 0 && dpw && dpw > 0) {
          const days = cycles * 4;
          const months = Math.max(1, Math.round(days / dpw / 4.345));
          secondary.textContent = `≈ ${months} mo at ${dpw}/wk · ${cycles} cycle${cycles === 1 ? "" : "s"}`;
        } else {
          secondary.textContent = "";
        }
      }
    }

    function bump(target: "current-inc" | "current-dec" | "goal-inc" | "goal-dec"): void {
      const delta = target.endsWith("inc") ? STEP : -STEP;
      if (target.startsWith("current")) {
        currentVal = Math.max(STEP, currentVal + delta);
        liftState[lift].current = currentVal;
      } else {
        goalVal = Math.max(STEP, goalVal + delta);
        liftState[lift].goal = goalVal;
      }
    }

    function bumpDpw(delta: number): void {
      const current = dpw ?? 0;
      const next = current + delta;
      if (next <= 0) {
        dpw = null;
      } else {
        dpw = Math.min(7, next);
      }
    }

    root.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const liftBtn = target.closest<HTMLButtonElement>("[data-lift]");
      if (liftBtn) {
        const nextLift = liftBtn.dataset.lift as Lift;
        if (nextLift !== lift) {
          lift = nextLift;
          currentVal = liftState[lift].current;
          goalVal = liftState[lift].goal;
          render();
        }
        return;
      }
      const kindBtn = target.closest<HTMLButtonElement>("[data-kind]");
      if (kindBtn) {
        kind = kindBtn.dataset.kind as Kind;
        render();
        return;
      }
      const stepBtn = target.closest<HTMLButtonElement>("[data-step]");
      if (stepBtn) {
        const step = stepBtn.dataset.step;
        if (step === "dpw-inc") bumpDpw(+1);
        else if (step === "dpw-dec") bumpDpw(-1);
        else if (step) bump(step as "current-inc" | "current-dec" | "goal-inc" | "goal-dec");
        render();
      }
    });

    render();
  }
</script>

<script>
  // Interactive plate calculator - Discord 1508988573. Wraps the
  // existing PhonePlateBar SSR with vanilla JS that listens for ±
  // clicks on the new stepper and re-renders the plate stacks +
  // readout numbers off the shared `~/lib/plates` math.
  //
  // We don't re-emit the whole PhonePlateBar template; we keep its
  // outer chrome (collar, bar-mid) and only swap the two `.stack`
  // children + the `.caption`. Same classes, same inline styles the
  // Astro template would have produced for the new weight.
  import {
    barWeight,
    convertWeight,
    decompose,
    groupPlates,
    plateLabel,
    sizeFor,
    stepFor,
    type Unit,
  } from '~/lib/plates';

  const MAX_BY_UNIT: Record<Unit, number> = { lb: 600, kg: 275 };
  const INITIAL_WEIGHT_LB = 250;

  const root = document.querySelector<HTMLElement>('[data-plate-calc]');
  if (root) {
    const weightEl = root.querySelector<HTMLElement>('[data-plate-weight]');
    const perSideEl = root.querySelector<HTMLElement>('[data-plate-perside]');
    const barEl = root.querySelector<HTMLElement>('[data-plate-bar]');
    const countEl = root.querySelector<HTMLElement>('[data-plate-count]');
    const decBtn = root.querySelector<HTMLButtonElement>('[data-plate-step="dec"]');
    const incBtn = root.querySelector<HTMLButtonElement>('[data-plate-step="inc"]');
    const plateBar = root.querySelector<HTMLElement>('.plate-bar');
    const unitLabels = root.querySelectorAll<HTMLElement>('[data-plate-unit-label]');
    const unitOpts = root.querySelectorAll<HTMLButtonElement>('[data-plate-unit]');

    if (weightEl && perSideEl && barEl && countEl && decBtn && incBtn && plateBar) {
      // Hoist into const-locals so the inner closures see the
      // already-narrowed (non-null) types - astro check doesn't
      // propagate the outer `&&` guard into nested function bodies.
      const wEl: HTMLElement = weightEl;
      const psEl: HTMLElement = perSideEl;
      const brEl: HTMLElement = barEl;
      const cEl: HTMLElement = countEl;
      const dBtn: HTMLButtonElement = decBtn;
      const iBtn: HTMLButtonElement = incBtn;
      const pBar: HTMLElement = plateBar;
      const leftStack = pBar.querySelector<HTMLElement>('.stack-left');
      const rightStack = pBar.querySelector<HTMLElement>('.stack:not(.stack-left)');
      const collar = pBar.querySelector<HTMLElement>('.collar');
      const captionR = pBar.querySelector<HTMLElement>('.caption-r');
      const H = 140; // matches PhonePlateBar size="hero"
      const plateW = 22;

      let unit: Unit = 'lb';
      let weight = INITIAL_WEIGHT_LB;

      function renderPlate(p: number): HTMLDivElement {
        const el = document.createElement('div');
        el.className = 'plate';
        const h = H * sizeFor(p, unit);
        // Plate layout (border-radius / display:flex / centered children) is
        // also scoped inside PhonePlateBar.astro - inline it here so the
        // rotated label sits centered on the JS-injected plate the same
        // way it does on the SSR'd ones.
        el.setAttribute(
          'style',
          [
            `width: ${plateW}px`,
            `height: ${h}px`,
            'background: var(--ink-0)',
            'border-radius: 1px',
            'display: flex',
            'align-items: center',
            'justify-content: center',
            'position: relative',
          ].join('; '),
        );
        if (h >= 30 && plateW >= 10) {
          const label = document.createElement('span');
          label.className = 'plate-label';
          // Inline the rotated label typography because Astro scopes
          // PhonePlateBar's `<style>` block to its own SSR'd elements.
          // Dynamically-injected spans don't inherit the scope and would
          // otherwise render as flat, un-rotated text (Discord
          // 1508997365 - "the plate number is wrong, should be vertical
          // aligned + rotated, style it like the actual app"). Numbers
          // here match the `size-hero` block in PhonePlateBar.astro.
          label.style.cssText = [
            'font-family: var(--font-mono)',
            'font-size: 14px',
            'line-height: 12px',
            'letter-spacing: 1.4px',
            'font-weight: 700',
            'transform: rotate(-90deg)',
            'transform-origin: center',
            'white-space: nowrap',
            'pointer-events: none',
            'color: var(--bg-0)',
          ].join('; ');
          label.textContent = plateLabel(p);
          el.appendChild(label);
        }
        return el;
      }

      function renderCaption(perSide: readonly number[]): void {
        if (!captionR) return;
        captionR.innerHTML = '';
        const grouped = groupPlates(perSide);
        // Local reference so the IIFE below sees a stable unit.
        const u = unit;
        if (grouped.length === 0) {
          const dash = document.createElement('span');
          dash.style.color = 'var(--ink-2)';
          dash.textContent = ' - ';
          captionR.appendChild(dash);
          return;
        }
        grouped.forEach((g, i) => {
          const group = document.createElement('span');
          group.className = 'group';
          if (i > 0) {
            const plus = document.createElement('span');
            plus.className = 'plus';
            plus.style.color = 'var(--ink-3)';
            plus.textContent = '+';
            group.appendChild(plus);
          }
          if (g.count > 1) {
            const count = document.createElement('span');
            count.className = 'count';
            count.style.color = 'var(--ink-2)';
            count.textContent = `${g.count}×`;
            group.appendChild(count);
          }
          const num = document.createElement('span');
          num.className = 'num';
          num.style.color = 'var(--ink-0)';
          num.textContent = plateLabel(g.weight);
          group.appendChild(num);
          captionR.appendChild(group);
        });
        const total = document.createElement('span');
        total.className = 'total';
        total.style.color = 'var(--ink-0)';
        const sum = perSide.reduce((s, p) => s + p, 0);
        total.textContent = `= ${sum} ${u}`;
        captionR.appendChild(total);
      }

      function render(): void {
        const step = stepFor(unit);
        const min = barWeight(unit);
        const max = MAX_BY_UNIT[unit];
        wEl.textContent = String(weight);
        for (const lbl of unitLabels) lbl.textContent = unit === 'lb' ? 'lbs' : 'kg';
        brEl.textContent = String(min);
        const { perSide } = decompose(weight, unit);
        const perSideTotal = perSide.reduce((s, p) => s + p, 0);

        psEl.textContent = String(perSideTotal);
        cEl.textContent = String(perSide.length);

        if (leftStack) {
          leftStack.innerHTML = '';
          for (const p of perSide) leftStack.appendChild(renderPlate(p));
        }
        if (rightStack) {
          rightStack.innerHTML = '';
          for (const p of perSide) rightStack.appendChild(renderPlate(p));
        }

        // Collar only shows when there are plates loaded. The Astro
        // template renders/omits it conditionally; in the JS path we
        // toggle visibility instead of remounting.
        if (collar) {
          collar.style.display = perSide.length > 0 ? '' : 'none';
        }

        renderCaption(perSide);

        dBtn.disabled = weight - step < min;
        iBtn.disabled = weight + step > max;

        for (const opt of unitOpts) {
          const on = opt.dataset.plateUnit === unit;
          opt.classList.toggle('active', on);
          opt.setAttribute('aria-selected', String(on));
        }

        pBar.setAttribute(
          'aria-label',
          perSide.length > 0
            ? `${weight} ${unit} loaded - bar plus ${perSideTotal} ${unit} per side`
            : `${weight} ${unit} loaded - bar only`,
        );
      }

      dBtn.addEventListener('click', () => {
        const step = stepFor(unit);
        if (weight - step < barWeight(unit)) return;
        weight -= step;
        render();
      });
      iBtn.addEventListener('click', () => {
        const step = stepFor(unit);
        if (weight + step > MAX_BY_UNIT[unit]) return;
        weight += step;
        render();
      });

      for (const opt of unitOpts) {
        opt.addEventListener('click', () => {
          const next = opt.dataset.plateUnit as Unit | undefined;
          if (!next || next === unit) return;
          // Convert + snap so the visible weight is plate-loadable
          // in the destination unit. `convertWeight` rounds to the
          // target unit's step (5 lb / 2.5 kg).
          weight = Math.max(barWeight(next), convertWeight(weight, unit, next));
          unit = next;
          render();
        });
      }

      // Initial sync - guarantees the readout/stacks match the
      // declared INITIAL even if the SSR snapshot drifts later.
      render();
    }
  }
</script>

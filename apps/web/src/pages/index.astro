---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import BlogCard from '~/components/BlogCard.astro';

const features = [
  {
    glyph: '5·3·1',
    title: 'Jim Wendler’s 5/3/1, faithfully',
    body:
      'Four-week cycles, three working sets, AMRAP on the last. The plates and percentages compute themselves so you can focus on the bar.',
  },
  {
    glyph: 'BBB',
    title: 'Boring But Big assistance built-in',
    body:
      '5×10 at 50–60% on the main lift, tracked in the same flow. No tab-hopping, no separate calculators, no spreadsheets.',
  },
  {
    glyph: 'PR',
    title: 'Honest progress, not vanity',
    body:
      'Estimated 1RMs from AMRAPs, training-max bumps cycle to cycle, and an e-ink-style PR certificate when you earn a new best.',
  },
  {
    glyph: 'OFF',
    title: 'Offline-first, on-device',
    body:
      'Drizzle + expo-sqlite locally. No accounts, no cloud, no telemetry. Your training stays on your phone, forever.',
  },
];

const surfaces = [
  {
    name: 'Today',
    glyph: '01',
    desc: 'Tomorrow’s session, pre-staged. Plates worked out, AMRAP marked, rest target on the bar.',
  },
  {
    name: 'Live',
    glyph: '02',
    desc: 'One screen per phase — Set, Rest, AMRAP log. Big numbers, no chrome, count-down timer with haptics.',
  },
  {
    name: 'History',
    glyph: '03',
    desc: 'Sessions filed by cycle. PRs starred. Lifetime volume, current streak, longest streak — at a glance.',
  },
  {
    name: 'Settings',
    glyph: '04',
    desc: 'Training maxes, plate set, units, enabled lifts, rest target. Editable. Append-only history per TM.',
  },
];

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base
  title="531 — A 5/3/1 + BBB training app for serious lifters"
  description="A focused 5/3/1 + Boring But Big tracker for iOS and Android. Offline, on-device, free. The dev log is public."
>
  <Hero
    title="Train 5/3/1. Skip the spreadsheet."
    lead="531 is a focused 5/3/1 + Boring But Big training app for iOS and Android. It owns the program’s math — warmups, working sets, AMRAPs, TM bumps — so you can run the lift and log the set, nothing else."
  />

  <Section eyebrow="What it is" title="A tool for one program, done well." wide>
    <div id="what-it-is" />
    <FeatureGrid features={features} />
  </Section>

  <Section
    eyebrow="What’s inside"
    title="Four surfaces. No menus to learn."
    wide
    divider
  >
    <ol class="surfaces">
      {surfaces.map((s) => (
        <li>
          <span class="surfaces__num">{s.glyph}</span>
          <div>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section eyebrow="The specs" title="Built for the lift, not the app store." wide divider>
    <dl class="specs">
      <div>
        <dt>Platforms</dt>
        <dd>iOS · Android · Expo SDK 55 · New Architecture on</dd>
      </div>
      <div>
        <dt>Storage</dt>
        <dd>On-device SQLite via Drizzle. No accounts, no sync, no cloud.</dd>
      </div>
      <div>
        <dt>Tracking</dt>
        <dd>None. No analytics SDK, no crash reporter, no telemetry.</dd>
      </div>
      <div>
        <dt>Aesthetic</dt>
        <dd>E-ink paper. IBM Plex. One amber accent. Built to read at glance.</dd>
      </div>
      <div>
        <dt>Price</dt>
        <dd>Free. Open source. No subscription, no in-app purchase.</dd>
      </div>
      <div>
        <dt>Cadence</dt>
        <dd>Over-the-air updates ship every iteration of the dev loop.</dd>
      </div>
    </dl>
    <p class="cta-row">
      <a class="btn btn--primary" href="/process">How it’s built →</a>
      <a class="btn btn--ghost" href="/blog">Read the dev log</a>
    </p>
  </Section>

  {posts.length > 0 && (
    <Section eyebrow="Latest from the dev log" title="What shipped this week." wide divider>
      <div class="blog-teaser">
        {posts.map((post) => (
          <BlogCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            summary={post.data.summary}
            pubDate={post.data.pubDate}
            loopId={post.data.loopId}
            tags={post.data.tags}
          />
        ))}
      </div>
      <p class="more">
        <a href="/blog">All entries →</a>
      </p>
    </Section>
  )}
</Base>

<style>
  .surfaces {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 720px) {
    .surfaces {
      grid-template-columns: 1fr;
    }
  }

  .surfaces li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--line-faint);
  }

  .surfaces__num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    padding-top: 2px;
  }

  .surfaces h3 {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0 0 4px;
  }

  .surfaces p {
    color: var(--ink-1);
    line-height: 1.55;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-xl);
    margin: 0;
  }

  @media (max-width: 720px) {
    .specs {
      grid-template-columns: 1fr;
    }
  }

  .specs > div {
    border-top: 1px solid var(--line-faint);
    padding-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .specs dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .specs dd {
    margin: 0;
    color: var(--ink-1);
    font-size: 1rem;
    line-height: 1.55;
  }

  .cta-row {
    margin-top: var(--space-2xl);
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition:
      transform var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard);
  }

  .btn--primary {
    background: var(--ink-0);
    color: var(--bg-0);
  }
  .btn--primary:hover {
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--ink-0);
    border: 1px solid var(--line-strong);
  }
  .btn--ghost:hover {
    background: var(--bg-2);
  }

  .blog-teaser {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  @media (max-width: 880px) {
    .blog-teaser {
      grid-template-columns: 1fr;
    }
  }

  .more {
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .more a {
    text-decoration: none;
    color: var(--ink-0);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }
</style>

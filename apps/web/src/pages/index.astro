---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import BlogCard from '~/components/BlogCard.astro';
import PhoneFrame from '~/components/PhoneFrame.astro';
import MockToday from '~/components/mockups/MockToday.astro';
import MockLive from '~/components/mockups/MockLive.astro';
import MockPrCert from '~/components/mockups/MockPrCert.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base
  title="531 — A 5/3/1 + BBB training app for serious lifters"
  description="A focused 5/3/1 + Boring But Big tracker for iOS and Android. Offline, on-device, free. The dev log is public."
>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">5/3/1 + BBB · iOS · Android</span>
        <h1 class="hero__title">Train the program. Skip the spreadsheet.</h1>
        <p class="hero__lead">
          531 owns the math of Jim Wendler's 5/3/1 — warmups, working sets,
          AMRAPs, Boring But Big, training-max bumps — so the only thing
          left for you is the bar. One screen per phase. No accounts, no
          cloud, no telemetry. Free.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#inside">See it →</a>
          <a class="btn btn--ghost" href="/blog">Read the dev log</a>
        </div>
        <ul class="hero__bullets">
          <li><span class="bullet-glyph">·</span>4-week cycles, the AMRAP set tracked rep-by-rep.</li>
          <li><span class="bullet-glyph">·</span>5×10 BBB built in, not a separate flow.</li>
          <li><span class="bullet-glyph">·</span>E-ink paper UI. Big numbers, no chrome.</li>
          <li><span class="bullet-glyph">·</span>Offline-first. Local SQLite. No sign-in.</li>
        </ul>
      </div>

      <div class="hero__phone" aria-hidden="true">
        <PhoneFrame caption="Today">
          <MockToday />
        </PhoneFrame>
      </div>
    </div>
  </section>

  <Section
    eyebrow="Inside the app"
    title="Three surfaces. Three jobs."
    wide
    divider
  >
    <div id="inside" class="surfaces-row">
      <div class="surfaces-row__col">
        <PhoneFrame caption="Today">
          <MockToday />
        </PhoneFrame>
        <h3>Tomorrow's session, pre-staged</h3>
        <p>
          The plates work themselves out. Warmups at 40 / 50 / 60%,
          three working sets, AMRAP on the last. Tap Start. The app
          knows what comes next so you don't have to remember.
        </p>
      </div>
      <div class="surfaces-row__col">
        <PhoneFrame caption="Live · Rest">
          <MockLive />
        </PhoneFrame>
        <h3>The set runs the room</h3>
        <p>
          One phase per screen — Set, Rest, AMRAP log. The countdown
          fills the canvas. Haptic when rest is up. Undo lives one tap
          away on the bar; nothing else competes for your eye.
        </p>
      </div>
      <div class="surfaces-row__col">
        <PhoneFrame caption="PR · Earned">
          <MockPrCert />
        </PhoneFrame>
        <h3>An honest celebration when you earn one</h3>
        <p>
          AMRAP that beats your estimated 1RM? Full-bleed certificate,
          inverted palette, the delta over your old best. Closes back
          to the receipt. No confetti, no streak meta-game — the lift
          was the meta-game.
        </p>
      </div>
    </div>
  </Section>

  <Section eyebrow="The promise" title="Built for the lift, not the app store." wide divider>
    <dl class="specs">
      <div>
        <dt>Program</dt>
        <dd>5/3/1 with BBB assistance. Cycles, weeks, deload. AMRAPs estimated via Epley.</dd>
      </div>
      <div>
        <dt>Storage</dt>
        <dd>On-device SQLite via Drizzle. No accounts, no sync, no cloud.</dd>
      </div>
      <div>
        <dt>Tracking</dt>
        <dd>None. No analytics SDK, no crash reporter, no telemetry.</dd>
      </div>
      <div>
        <dt>Aesthetic</dt>
        <dd>E-ink paper. IBM Plex. One amber accent. Built to read at a glance.</dd>
      </div>
      <div>
        <dt>Price</dt>
        <dd>Free. Open source. No subscription, no in-app purchase.</dd>
      </div>
      <div>
        <dt>Cadence</dt>
        <dd>Shipped over-the-air every iteration of the dev loop.</dd>
      </div>
    </dl>
    <p class="cta-row">
      <a class="btn btn--primary" href="/process">How it's built →</a>
      <a class="btn btn--ghost" href="/blog">Read the dev log</a>
    </p>
  </Section>

  {posts.length > 0 && (
    <Section eyebrow="From the dev log" title="What shipped recently." wide divider>
      <div class="blog-teaser">
        {posts.map((post) => (
          <BlogCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            summary={post.data.summary}
            pubDate={post.data.pubDate}
            loopId={post.data.loopId}
            tags={post.data.tags}
          />
        ))}
      </div>
      <p class="more">
        <a href="/blog">All entries →</a>
      </p>
    </Section>
  )}
</Base>

<style>
  .hero {
    padding-block: var(--space-4xl) var(--space-3xl);
    border-bottom: 1px solid var(--line-faint);
  }
  .hero__inner {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }
  @media (max-width: 880px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
    .hero__phone {
      order: -1;
      justify-self: center;
    }
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .hero__title {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .hero__lead {
    color: var(--ink-1);
    font-size: 1.1rem;
    line-height: 1.55;
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xs);
    flex-wrap: wrap;
  }
  .hero__bullets {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .hero__bullets li {
    display: flex;
    gap: 8px;
  }
  .bullet-glyph {
    color: var(--ink-3);
  }
  .hero__phone {
    display: flex;
    justify-content: center;
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition:
      transform var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard);
  }
  .btn--primary {
    background: var(--ink-0);
    color: var(--bg-0);
  }
  .btn--primary:hover {
    transform: translateY(-1px);
  }
  .btn--ghost {
    background: transparent;
    color: var(--ink-0);
    border: 1px solid var(--line-strong);
  }
  .btn--ghost:hover {
    background: var(--bg-2);
  }

  .surfaces-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl) var(--space-xl);
    margin-top: var(--space-lg);
  }
  @media (max-width: 920px) {
    .surfaces-row {
      grid-template-columns: 1fr;
    }
  }
  .surfaces-row__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
  }
  .surfaces-row__col h3 {
    margin-top: var(--space-sm);
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 1.15rem;
  }
  .surfaces-row__col p {
    color: var(--ink-1);
    line-height: 1.55;
    max-width: 32ch;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-xl);
    margin: 0;
  }
  @media (max-width: 720px) {
    .specs {
      grid-template-columns: 1fr;
    }
  }
  .specs > div {
    border-top: 1px solid var(--line-faint);
    padding-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .specs dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .specs dd {
    margin: 0;
    color: var(--ink-1);
    font-size: 1rem;
    line-height: 1.55;
  }

  .cta-row {
    margin-top: var(--space-2xl);
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .blog-teaser {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  @media (max-width: 880px) {
    .blog-teaser {
      grid-template-columns: 1fr;
    }
  }

  .more {
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .more a {
    text-decoration: none;
    color: var(--ink-0);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }
</style>

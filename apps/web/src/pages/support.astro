---
import Base from '~/layouts/Base.astro';
---

<Base
  title="Support - 531 Strength"
  description="Get help with 531 Strength. File an issue on GitHub or send an email."
  ogImage="/screenshot-6.png"
>
  <section class="support">
    <div class="wrap">
      <div class="eyebrow">Support</div>
      <h1>Get help<span class="dot">.</span></h1>
      <p class="lede">
        531 Strength is a side project - no support team, just one developer.
        The best way to report a bug or ask a question is GitHub Issues.
      </p>

      <div class="options">
        <div class="option">
          <div class="option-label">Bugs and feature requests</div>
          <h2>GitHub Issues</h2>
          <p>
            The repo is public. File an issue and it will be read - usually
            within a day or two. Include your device, OS version, and steps
            to reproduce if you're reporting a bug.
          </p>
          <a
            href="https://github.com/alexcheuk/proof-531/issues"
            rel="noopener"
            class="pill"
          >Open an issue →</a>
        </div>

        <div class="option">
          <div class="option-label">Direct contact</div>
          <h2>Email</h2>
          <p>
            For anything you'd rather not post publicly - questions about
            the app, data handling, or anything else.
          </p>
          <a href="mailto:hi@531ledger.app" class="pill ghost">Email hi@531ledger.app →</a>
        </div>
      </div>

      <div class="note">
        <a href="/privacy">Privacy policy</a> ·
        <a href="https://github.com/alexcheuk/proof-531" rel="noopener">Source code</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .support {
    padding: var(--space-5xl) 0 var(--space-4xl);
  }

  .wrap {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-lg);
  }

  h1 {
    margin-bottom: var(--space-xl);
  }

  .dot {
    color: var(--amber);
  }

  .lede {
    font-size: 1.1rem;
    color: var(--ink-1);
    line-height: 1.6;
    max-width: 58ch;
    margin-bottom: var(--space-3xl);
  }

  .options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-3xl);
  }

  .option {
    padding: var(--space-xl);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .option-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .option h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .option p {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.6;
    flex: 1;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    background: var(--ink-0);
    color: var(--bg-0);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--ink-0);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
    align-self: flex-start;
  }
  .pill:hover { transform: translateY(-1px); }

  .pill.ghost {
    background: transparent;
    color: var(--ink-0);
  }
  .pill.ghost:hover { background: var(--bg-2); }

  .note {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: flex;
    gap: var(--space-lg);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--line);
  }

  .note a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .note a:hover { color: var(--ink-0); }

  @media (max-width: 600px) {
    .options {
      grid-template-columns: 1fr;
    }
  }
</style>

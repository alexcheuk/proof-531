---
import Base from '~/layouts/Base.astro';
---

<Base
  title="5/3/1 Training Max Goal Calculator - 531 Strength"
  description="Calculate how many 5/3/1 cycles it takes to reach your training max goal. See a cycle-by-cycle projection for squat, bench, deadlift, and overhead press."
  ogImage="/screenshot-6.png"
>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "5/3/1 Training Max Goal Calculator - 531 Strength",
    "applicationCategory": "SportsApplication",
    "description": "Calculate how many 5/3/1 cycles it takes to reach your training max goal. See a cycle-by-cycle projection for squat, bench, deadlift, and overhead press.",
    "url": "https://531strength.com/tools/goal-calendar",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": [
      "Cycle-by-cycle TM projection",
      "Per-lift progression rates (squat/deadlift +10lb, bench/press +5lb)",
      "lbs and kg support",
      "No account required"
    ]
  }
  </script>

  <section class="tool-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/tools">TOOLS</a>
        <span class="sep">›</span>
        <span>GOAL CALENDAR</span>
      </div>
      <h1>5/3/1 goal calculator<span class="dot">.</span></h1>
      <p class="lede">
        Enter your current training max, set a goal weight, and see a cycle-by-cycle projection
        of how many weeks it takes to get there on the 5/3/1 program.
      </p>
    </div>
  </section>

  <section class="tool-section">
    <div class="wrap">
      <div class="progression goal-calc" data-goal-calc>
        <div class="prog-left">
          <div class="caps">For this lift</div>
          <div class="calc-lifts" role="tablist" aria-label="Lift">
            <button class="calc-lift active" data-lift="squat" role="tab" aria-selected="true">Squat</button>
            <button class="calc-lift" data-lift="bench" role="tab" aria-selected="false">Bench</button>
            <button class="calc-lift" data-lift="deadlift" role="tab" aria-selected="false">Dead</button>
            <button class="calc-lift" data-lift="press" role="tab" aria-selected="false">Press</button>
          </div>
          <div class="prog-unit-row">
            <div class="caps">Units</div>
            <div class="pc-unit-toggle" role="group" aria-label="Units">
              <button class="pc-unit-opt active" data-unit="lb" aria-pressed="true">LB</button>
              <button class="pc-unit-opt" data-unit="kg" aria-pressed="false">KG</button>
            </div>
          </div>
          <div class="prog-numbers single">
            <div class="prog-num">
              <div class="amount">+<span id="bump-lb">10</span><span class="unit">lb</span></div>
              <div class="label" id="bump-label">Squat · per cycle</div>
              <div class="kg">or +<span id="bump-kg">5</span> kg</div>
            </div>
          </div>
          <p class="prog-note">
            A cycle is 4 sessions of this lift - not 4 calendar weeks. Each lift runs its own cycle, so you set your own pace.
          </p>
        </div>

        <div class="prog-right calc-card">
          <div class="caps">Run your numbers</div>

          <div class="calc-row">
            <div class="calc-row-l">
              <div class="caps">Current</div>
              <div class="calc-sub">training max</div>
            </div>
            <div class="calc-stepper">
              <button type="button" class="step-btn" id="btn-current-dec" aria-label="Decrease current TM">−</button>
              <div class="calc-val">
                <span id="current-tm-display">275</span>
                <span class="vu" id="current-unit-label">lb</span>
              </div>
              <button type="button" class="step-btn" id="btn-current-inc" aria-label="Increase current TM">+</button>
            </div>
          </div>

          <div class="calc-row">
            <div class="calc-row-l">
              <div class="caps">Goal</div>
              <div class="calc-sub">training max</div>
            </div>
            <div class="calc-stepper">
              <button type="button" class="step-btn" id="btn-goal-dec" aria-label="Decrease goal TM">−</button>
              <div class="calc-val big">
                <span id="goal-tm-display">315</span>
                <span class="vu" id="goal-unit-label">lb</span>
              </div>
              <button type="button" class="step-btn" id="btn-goal-inc" aria-label="Increase goal TM">+</button>
            </div>
          </div>

          <div class="calc-outcome" id="result-summary" aria-live="polite"></div>
        </div>
      </div>

      {/* Cycle table + share below the main card */}
      <div class="cycle-outer">
        <div class="cycle-table-wrap" id="cycle-table-wrap">
          <div class="cycle-table-head">
            <span class="caps">CYCLE</span>
            <span class="caps">TRAINING MAX</span>
            <span class="caps">TOTAL WEEKS</span>
          </div>
          <div class="cycle-table-body" id="cycle-table-body" aria-live="polite"></div>
        </div>
        <div class="share-row">
          <button class="copy-link-btn caps" id="copy-link-btn" type="button">Copy shareable link</button>
          <span class="copy-confirm caps" id="copy-confirm" aria-live="polite"></span>
        </div>
      </div>

      {/* CTA */}
      <div class="page-cta">
        <div class="cta-left">
          <div class="caps cta-label">USE IN THE APP</div>
          <p>
            The 531 Strength app tracks your TM automatically each cycle and shows your projected
            progression over time.
          </p>
        </div>
        <div class="cta-right">
          <a href="https://github.com/alexcheuk/proof-531/releases" rel="noopener" class="pill ghost">Download for Android →</a>
          <span class="pill ghost disabled" aria-label="iOS App Store coming soon">iOS · Soon</span>
        </div>
      </div>

      {/* FAQ / context section */}
      <div class="faq-section">
        <h2 class="faq-heading">About this calculator</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>What is a training max?</h3>
            <p>In Jim Wendler's 5/3/1 program, your training max (TM) is the weight your working sets are calculated from. It is typically set at 85–90% of your actual one-rep max, giving you room to train hard without grinding against your true limit every session. Each cycle, your TM increases by 10 lb for squat and deadlift, and 5 lb for bench and overhead press.</p>
          </div>
          <div class="faq-item">
            <h3>How long does it take to reach a goal on 5/3/1?</h3>
            <p>5/3/1 runs in 4-week cycles. With standard progression (+10 lb per cycle on lower-body lifts, +5 lb on upper-body), adding 100 lb to your squat training max takes 10 cycles - roughly 40 weeks. This calculator shows the exact cycle-by-cycle path from your current TM to any goal TM, including total weeks and months.</p>
          </div>
          <div class="faq-item">
            <h3>Squat and deadlift vs. bench and press</h3>
            <p>5/3/1 uses different increment rates per lift. Lower-body lifts (squat, deadlift) increase by 10 lb (5 kg) per cycle. Upper-body lifts (bench press, overhead press) increase by 5 lb (2.5 kg) per cycle. Select the correct lift to see the accurate projection - the same goal takes different amounts of time depending on which movement you're tracking.</p>
          </div>
          <div class="faq-item">
            <h3>Shareable links</h3>
            <p>Your current settings (unit, lift, current TM, goal TM) are stored in the URL. Use "Copy shareable link" to save a specific projection or share it with a coach or training partner. The link opens directly to the same state - no account required.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
(function () {
  var state = {
    unit: 'lb',
    lift: 'squat',
    currentTM: 275,
    goalTM: 315,
  };

  var LIFT_CONFIG = {
    squat:     { incLb: 10, incKg: 5,   label: 'SQUAT · DEADLIFT' },
    deadlift:  { incLb: 10, incKg: 5,   label: 'SQUAT · DEADLIFT' },
    bench:     { incLb: 5,  incKg: 2.5, label: 'BENCH · PRESS' },
    press:     { incLb: 5,  incKg: 2.5, label: 'BENCH · PRESS' },
  };

  var MAX_CYCLES = 52;

  // ── DOM refs ──────────────────────────────────────────────────────────
  var bumpLb          = document.getElementById('bump-lb');
  var bumpKg          = document.getElementById('bump-kg');
  var bumpLabel       = document.getElementById('bump-label');
  var currentTMDisplay = document.getElementById('current-tm-display');
  var goalTMDisplay   = document.getElementById('goal-tm-display');
  var currentUnitLabel = document.getElementById('current-unit-label');
  var goalUnitLabel   = document.getElementById('goal-unit-label');
  var resultSummary   = document.getElementById('result-summary');
  var cycleTableBody  = document.getElementById('cycle-table-body');

  // ── helpers ───────────────────────────────────────────────────────────
  function getIncrement() {
    var cfg = LIFT_CONFIG[state.lift];
    return state.unit === 'lb' ? cfg.incLb : cfg.incKg;
  }

  function getStep() {
    return state.unit === 'lb' ? 5 : 2.5;
  }

  function fmtW(w) {
    if (w % 1 === 0) return String(w);
    if ((w * 10) % 1 === 0) return w.toFixed(1);
    return w.toFixed(2);
  }

  function unitLabel() {
    return state.unit === 'lb' ? 'LB' : 'KG';
  }

  // ── render ────────────────────────────────────────────────────────────
  function render() {
    var ul = unitLabel();
    var inc = getIncrement();
    var cfg = LIFT_CONFIG[state.lift];
    if (bumpLb) bumpLb.textContent = String(cfg.incLb);
    if (bumpKg) bumpKg.textContent = String(cfg.incKg);
    if (bumpLabel) bumpLabel.textContent = (state.lift.charAt(0).toUpperCase() + state.lift.slice(1)) + ' · per cycle';
    currentTMDisplay.textContent = fmtW(state.currentTM);
    goalTMDisplay.textContent = fmtW(state.goalTM);
    currentUnitLabel.textContent = ul;
    goalUnitLabel.textContent = ul;

    // calc cycles
    if (state.goalTM <= state.currentTM) {
      resultSummary.innerHTML = '<div class="already-there">ALREADY AT GOAL</div>';
      cycleTableBody.innerHTML = '';
      return;
    }

    var cycles = [];
    var tm = state.currentTM;
    var cycleNum = 0;
    while (tm < state.goalTM && cycleNum < MAX_CYCLES) {
      cycleNum++;
      tm = Math.round((tm + inc) * 1000) / 1000;
      cycles.push({ cycle: cycleNum, tm: tm, weeks: cycleNum * 4 });
    }

    var totalCycles = cycles.length;
    var totalWeeks = totalCycles * 4;
    var totalMonths = (totalWeeks / 4.33).toFixed(1);

    resultSummary.innerHTML =
      '<div class="o-l">~' + totalWeeks + ' work days away</div>' +
      '<div class="o-r">≈ ' + totalMonths + ' mo · ' + totalCycles + ' cycle' + (totalCycles !== 1 ? 's' : '') + ' · +' + fmtW(state.goalTM - state.currentTM) + ' ' + ul + '</div>';

    // table rows - show all but mark goal row
    var html = '';
    cycles.forEach(function (row) {
      var isGoal = row.tm >= state.goalTM;
      html += '<div class="cycle-row' + (isGoal ? ' cycle-row--goal' : '') + '">' +
        '<span class="cycle-num">' + row.cycle + '</span>' +
        '<span class="cycle-tm">' + fmtW(row.tm) + ' <span class="cycle-unit caps">' + ul + '</span>' +
          (isGoal ? ' <span class="goal-tag caps">GOAL</span>' : '') +
        '</span>' +
        '<span class="cycle-weeks caps">' + row.weeks + ' WK</span>' +
        '</div>';
    });

    if (totalCycles >= MAX_CYCLES) {
      html += '<div class="cycle-row cycle-row--more">' +
        '<span class="caps" style="grid-column:1/-1">SHOWING ' + MAX_CYCLES + ' CYCLES MAX</span>' +
        '</div>';
    }

    cycleTableBody.innerHTML = html;
  }

  // ── event handlers ────────────────────────────────────────────────────
  document.querySelectorAll('.pc-unit-opt[data-unit]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var newUnit = this.dataset.unit;
      if (newUnit === state.unit) return;
      if (newUnit === 'kg') {
        state.currentTM = Math.round((state.currentTM / 2.20462) / 2.5) * 2.5;
        state.goalTM    = Math.round((state.goalTM    / 2.20462) / 2.5) * 2.5;
      } else {
        state.currentTM = Math.round((state.currentTM * 2.20462) / 5) * 5;
        state.goalTM    = Math.round((state.goalTM    * 2.20462) / 5) * 5;
      }
      state.unit = newUnit;
      document.querySelectorAll('.pc-unit-opt[data-unit]').forEach(function (b) {
        var on = b.dataset.unit === state.unit;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      render();
    });
  });

  document.querySelectorAll('.calc-lift').forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.lift = this.dataset.lift;
      document.querySelectorAll('.calc-lift').forEach(function (b) {
        var on = b.dataset.lift === state.lift;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      render();
    });
  });

  document.getElementById('btn-current-inc').addEventListener('click', function () {
    state.currentTM = Math.round((state.currentTM + getStep()) * 1000) / 1000;
    render();
  });
  document.getElementById('btn-current-dec').addEventListener('click', function () {
    var newV = Math.round((state.currentTM - getStep()) * 1000) / 1000;
    if (newV > 0) { state.currentTM = newV; render(); }
  });
  document.getElementById('btn-goal-inc').addEventListener('click', function () {
    state.goalTM = Math.round((state.goalTM + getStep()) * 1000) / 1000;
    render();
  });
  document.getElementById('btn-goal-dec').addEventListener('click', function () {
    var newV = Math.round((state.goalTM - getStep()) * 1000) / 1000;
    if (newV > 0) { state.goalTM = newV; render(); }
  });

  // ── URL state ─────────────────────────────────────────────────────────
  function pushUrl() {
    var params = new URLSearchParams();
    params.set('u', state.unit);
    params.set('l', state.lift);
    params.set('c', String(state.currentTM));
    params.set('g', String(state.goalTM));
    history.replaceState(null, '', '?' + params.toString());
  }

  var _render = render;
  render = function () { _render(); pushUrl(); };

  // ── copy link ─────────────────────────────────────────────────────────
  var copyBtn = document.getElementById('copy-link-btn');
  var copyConfirm = document.getElementById('copy-confirm');
  var copyTimer = null;
  copyBtn.addEventListener('click', function () {
    navigator.clipboard.writeText(window.location.href).then(function () {
      copyConfirm.textContent = 'Copied!';
      if (copyTimer) clearTimeout(copyTimer);
      copyTimer = setTimeout(function () { copyConfirm.textContent = ''; }, 2000);
    }).catch(function () { copyConfirm.textContent = 'Copy failed'; });
  });

  // ── init from URL ──────────────────────────────────────────────────────
  (function () {
    var params = new URLSearchParams(window.location.search);
    var u = params.get('u');
    var l = params.get('l');
    var c = params.get('c');
    var g = params.get('g');
    var validLifts = ['squat', 'deadlift', 'bench', 'press'];
    if (u === 'lb' || u === 'kg') state.unit = u;
    if (l && validLifts.indexOf(l) >= 0) state.lift = l;
    var pc = parseFloat(c);
    var pg = parseFloat(g);
    if (!isNaN(pc) && pc > 0) state.currentTM = pc;
    if (!isNaN(pg) && pg > 0) state.goalTM = pg;

    // Sync toggle UI to loaded state
    document.querySelectorAll('.pc-unit-opt[data-unit]').forEach(function (btn) {
      var active = btn.dataset.unit === state.unit;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
    document.querySelectorAll('.calc-lift').forEach(function (btn) {
      var active = btn.dataset.lift === state.lift;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', String(active));
    });
  })();

  render();
})();
</script>

<style>
  .wrap {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .dot { color: var(--amber); }
  .caps {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* ── hero ── */
  .tool-hero {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .tool-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, var(--line-faint) 1px, transparent 1px);
    background-size: 96px 100%;
    opacity: 0.5;
    pointer-events: none;
  }
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 20px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .breadcrumb a:hover { color: var(--ink-0); }
  .breadcrumb .sep { color: var(--line-strong); }

  h1 {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(40px, 5.5vw, 72px);
    line-height: 0.97;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    color: var(--ink-0);
    position: relative;
  }
  .lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-1);
    max-width: 48ch;
    margin: 0;
    position: relative;
  }

  /* ── tool section ── */
  .tool-section {
    padding: 56px 0 80px;
  }

  /* ── progression goal calc (matches home page) ── */
  .progression {
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
    margin-bottom: 32px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
  }
  .prog-left {
    padding: 36px 40px;
    border-right: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--bg-1);
  }
  .prog-left .caps { color: var(--ink-2); }
  .prog-numbers.single { margin: 0; }
  .prog-num .amount {
    font-family: var(--font-cond);
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink-0);
  }
  .prog-num .amount .unit {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink-2);
    margin-left: 6px;
  }
  .prog-num .label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-top: 8px;
  }
  .prog-num .kg {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-top: 4px;
  }
  .prog-note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
  .prog-unit-row {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: space-between;
  }
  .pc-unit-toggle {
    display: inline-flex;
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
  }
  .pc-unit-opt {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    padding: 6px 12px;
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
  }
  .pc-unit-opt:hover { color: var(--ink-0); }
  .pc-unit-opt.active { background: var(--ink-0); color: var(--bg-0); }
  .prog-right {
    padding: 36px 40px;
  }
  .calc-card {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .calc-card > .caps {
    margin-bottom: 20px;
  }
  .calc-lifts {
    display: flex;
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: 0;
  }
  .calc-lift {
    appearance: none;
    background: transparent;
    border: none;
    border-right: 1px solid var(--line);
    padding: 8px 14px;
    font-family: var(--font-cond);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-3);
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
  }
  .calc-lift:last-child { border-right: none; }
  .calc-lift:hover { color: var(--ink-0); background: var(--bg-1); }
  .calc-lift.active { color: var(--ink-0); background: var(--bg-1); border-bottom: 2px solid var(--ink-0); }
  .calc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-faint);
  }
  .calc-row:last-of-type { border-bottom: none; }
  .calc-row-l .caps { color: var(--ink-1); }
  .calc-sub {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 3px;
  }
  .calc-stepper {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .step-btn {
    appearance: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
    flex-shrink: 0;
    padding: 0;
  }
  .step-btn:hover { background: var(--ink-0); color: var(--bg-0); }
  .calc-val {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--ink-0);
    min-width: 80px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .calc-val.big { font-size: 36px; }
  .vu {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--ink-2);
    text-transform: uppercase;
    margin-left: 4px;
  }
  .calc-outcome {
    margin-top: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: baseline;

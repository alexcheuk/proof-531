---
import Base from '~/layouts/Base.astro';
import PhonePlateBar from '~/components/illustrations/PhonePlateBar.astro';
---

<Base
  title="5/3/1 Plate Math Calculator — 531 Strength"
  description="Free barbell plate calculator for 5/3/1 and any strength program. Enter a target weight, pick your bar, and instantly see which plates to load per side."
  ogImage="/screenshot-6.png"
>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "5/3/1 Plate Math Calculator — 531 Strength",
    "applicationCategory": "SportsApplication",
    "description": "Free barbell plate calculator for 5/3/1 and any strength program. Enter a target weight, pick your bar, and instantly see which plates to load per side.",
    "url": "https://531strength.com/tools/plate-math",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": [
      "lbs and kg support",
      "Multiple bar weights (45lb, 35lb, 20kg, 15kg)",
      "Visual plate layout per side",
      "No account required"
    ]
  }
  </script>

  <section class="tool-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/tools">TOOLS</a>
        <span class="sep">›</span>
        <span>PLATE CALCULATOR</span>
      </div>
      <h1>5/3/1 plate calculator<span class="dot">.</span></h1>
      <p class="lede">
        Enter a target weight, pick your bar, and see exactly which plates to load on each side. Works for any strength program.
      </p>
    </div>
  </section>

  <section class="tool-section">
    <div class="wrap">
      <div class="plate-card" data-plate-calc>
        <div class="pc-left">
          <div>
            <div class="pc-head">
              <div class="caps">Target weight</div>
              <div class="pc-unit-toggle" role="tablist" aria-label="Unit">
                <button class="pc-unit-opt active" data-plate-unit="lb" role="tab" aria-selected="true">LB</button>
                <button class="pc-unit-opt" data-plate-unit="kg" role="tab" aria-selected="false">KG</button>
              </div>
            </div>
            <div class="pc-bar-row">
              <div class="caps">Bar</div>
              <div class="pc-unit-toggle" role="group" aria-label="Bar weight">
                <button class="pc-unit-opt active" data-bar-lb="45" data-bar-kg="20" aria-pressed="true">STANDARD</button>
                <button class="pc-unit-opt" data-bar-lb="35" data-bar-kg="15" aria-pressed="false">WOMEN'S</button>
              </div>
            </div>
            <div class="pc-target">
              <button class="pc-step" data-plate-step="dec" aria-label="Decrease weight">−</button>
              <h3>
                <span data-plate-weight>135</span>
                <span class="pc-unit"> <span data-plate-unit-label>lb</span></span>
              </h3>
              <button class="pc-step" data-plate-step="inc" aria-label="Increase weight">+</button>
            </div>
          </div>
          <div class="pc-readout">
            <div class="item">
              <div class="l">Per side</div>
              <div class="v"><span data-plate-perside>45</span><span class="unit"> <span data-plate-unit-label>lb</span></span></div>
            </div>
            <div class="item">
              <div class="l">Bar</div>
              <div class="v"><span data-plate-bar>45</span><span class="unit"> <span data-plate-unit-label>lb</span></span></div>
            </div>
            <div class="item">
              <div class="l">Plates</div>
              <div class="v"><span data-plate-count>1</span><span class="unit"> ea</span></div>
            </div>
          </div>
          <div id="plate-list" class="pc-plate-list" aria-live="polite" aria-label="Plate breakdown"></div>
          <div id="result-note" class="pc-result-note" aria-live="polite"></div>
          <div class="pc-extras">
            <div class="pc-input-row">
              <label class="caps" for="weight-input-field">Enter directly</label>
              <input
                type="number"
                id="weight-input-field"
                value="135"
                min="0"
                step="5"
                class="pc-direct-input"
                aria-label="Target weight"
              />
            </div>
            <div class="share-row">
              <button class="copy-link-btn caps" id="copy-link-btn" type="button">Copy shareable link</button>
              <span class="copy-confirm caps" id="copy-confirm" aria-live="polite"></span>
            </div>
          </div>
        </div>
        <div class="pc-right">
          <PhonePlateBar weight={135} unit="lb" size="hero" withCaption />
        </div>
      </div>

      {/* CTA */}
      <div class="page-cta">
        <div class="cta-left">
          <div class="caps cta-label">USE IN THE APP</div>
          <p>
            The 531 Strength app shows plate math live for every working set — no mental math during your session.
          </p>
        </div>
        <div class="cta-right">
          <a href="https://github.com/alexcheuk/proof-531/releases" rel="noopener" class="pill ghost">Download for Android →</a>
          <span class="pill ghost disabled" aria-label="iOS App Store coming soon">iOS · Soon</span>
        </div>
      </div>

      {/* FAQ / context section */}
      <div class="faq-section">
        <h2 class="faq-heading">How to use this calculator</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>What is plate math?</h3>
            <p>Plate math is the process of figuring out which weight plates to load on a barbell to hit a target weight. You subtract the bar weight (usually 45 lb / 20 kg), divide the remainder in half to get the per-side load, then match that against your available plates — starting with the heaviest and working down. This calculator does it automatically.</p>
          </div>
          <div class="faq-item">
            <h3>How does 5/3/1 plate math work?</h3>
            <p>In Jim Wendler's 5/3/1 program, your working weights are percentages of your training max. If your squat training max is 300 lb, your Week 1 working set at 65% is 195 lb. Enter 195 in this calculator: subtract the 45 lb bar, split 150 lb across two sides — 75 lb per side, loaded as 45+25+5. The calculator handles this for every set instantly.</p>
          </div>
          <div class="faq-item">
            <h3>Standard vs. Women's bar</h3>
            <p>A standard Olympic barbell weighs 45 lb (20 kg). A women's Olympic bar weighs 35 lb (15 kg). Select the correct bar type before calculating — the starting weight changes the plate breakdown. Most commercial squat racks and bench stations use the standard 45 lb bar.</p>
          </div>
          <div class="faq-item">
            <h3>Shareable links</h3>
            <p>Every calculator state has a unique URL — weight, unit, and bar type are encoded in the query string. Use "Copy shareable link" to grab the current configuration and send it to a training partner or save it for a specific working weight you check often.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import {
    barWeight,
    convertWeight,
    decompose,
    groupPlates,
    plateLabel,
    sizeFor,
    stepFor,
    type Unit,
  } from '~/lib/plates';

  const MAX_BY_UNIT: Record<Unit, number> = { lb: 600, kg: 275 };

  const root = document.querySelector<HTMLElement>('[data-plate-calc]');
  if (!root) throw new Error('no plate-calc root');

  const weightEl = root.querySelector<HTMLElement>('[data-plate-weight]')!;
  const perSideEl = root.querySelector<HTMLElement>('[data-plate-perside]')!;
  const barEl = root.querySelector<HTMLElement>('[data-plate-bar]')!;
  const countEl = root.querySelector<HTMLElement>('[data-plate-count]')!;
  const decBtn = root.querySelector<HTMLButtonElement>('[data-plate-step="dec"]')!;
  const incBtn = root.querySelector<HTMLButtonElement>('[data-plate-step="inc"]')!;
  const pBar = root.querySelector<HTMLElement>('.plate-bar')!;
  const leftStack = pBar.querySelector<HTMLElement>('.stack-left')!;
  const rightStack = pBar.querySelector<HTMLElement>('.stack:not(.stack-left)')!;
  const collar = pBar.querySelector<HTMLElement>('.collar');
  const captionR = pBar.querySelector<HTMLElement>('.caption-r');
  const unitLabels = root.querySelectorAll<HTMLElement>('[data-plate-unit-label]');
  const unitOpts = root.querySelectorAll<HTMLButtonElement>('[data-plate-unit]');
  const barOpts = root.querySelectorAll<HTMLButtonElement>('[data-bar-lb]');
  const plateListEl = document.getElementById('plate-list');
  const resultNoteEl = document.getElementById('result-note');
  const weightInputField = document.getElementById('weight-input-field') as HTMLInputElement | null;
  const copyBtn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
  const copyConfirm = document.getElementById('copy-confirm') as HTMLElement | null;

  const H = 140;
  const plateW = 22;

  // Init from URL params
  const params = new URLSearchParams(window.location.search);
  let unit: Unit = (['lb', 'kg'].includes(params.get('unit') ?? '') ? params.get('unit') as Unit : 'lb');
  let barLb = parseInt(params.get('bar') ?? '45', 10) === 35 ? 35 : 45;
  let weight = Math.max(45, parseInt(params.get('w') ?? '135', 10) || 135);

  function getCustomBar(): number {
    return unit === 'lb' ? barLb : (barLb === 45 ? 20 : 15);
  }

  function renderPlate(p: number): HTMLDivElement {
    const el = document.createElement('div');
    el.className = 'plate';
    const h = H * sizeFor(p, unit);
    el.setAttribute('style', [
      `width: ${plateW}px`, `height: ${h}px`,
      'background: var(--ink-0)', 'border-radius: 1px',
      'display: flex', 'align-items: center', 'justify-content: center', 'position: relative',
    ].join('; '));
    if (h >= 30) {
      const lbl = document.createElement('span');
      lbl.className = 'plate-label';
      lbl.style.cssText = [
        'font-family: var(--font-mono)', 'font-size: 14px', 'line-height: 12px',
        'letter-spacing: 1.4px', 'font-weight: 700',
        'transform: rotate(-90deg)', 'transform-origin: center',
        'white-space: nowrap', 'pointer-events: none', 'color: var(--bg-0)',
      ].join('; ');
      lbl.textContent = plateLabel(p);
      el.appendChild(lbl);
    }
    return el;
  }

  function renderCaption(perSide: readonly number[]): void {
    if (!captionR) return;
    captionR.innerHTML = '';
    const grouped = groupPlates(perSide);
    const u = unit;
    if (!grouped.length) {
      const dash = document.createElement('span');
      dash.style.color = 'var(--ink-2)';
      dash.textContent = '—';
      captionR.appendChild(dash);
      return;
    }
    grouped.forEach((g, i) => {
      const grp = document.createElement('span');
      grp.className = 'group';
      if (i > 0) { const plus = document.createElement('span'); plus.className = 'plus'; plus.style.color = 'var(--ink-3)'; plus.textContent = '+'; grp.appendChild(plus); }
      if (g.count > 1) { const ct = document.createElement('span'); ct.className = 'count'; ct.style.color = 'var(--ink-2)'; ct.textContent = `${g.count}×`; grp.appendChild(ct); }
      const num = document.createElement('span'); num.className = 'num'; num.style.color = 'var(--ink-0)'; num.textContent = plateLabel(g.weight); grp.appendChild(num);
      captionR.appendChild(grp);
    });
    const tot = document.createElement('span');
    tot.className = 'total'; tot.style.color = 'var(--ink-0)';
    tot.textContent = `= ${perSide.reduce((s, p) => s + p, 0)} ${u}`;
    captionR.appendChild(tot);
  }

  function render(): void {
    const step = stepFor(unit);
    const stdBar = barWeight(unit);
    const customBar = getCustomBar();
    // Adjust weight for custom bar: shift target so decompose gives correct per-side for the chosen bar
    const adjusted = weight + (stdBar - customBar);
    const { perSide } = decompose(adjusted, unit);
    const perSideTotal = perSide.reduce((s, p) => s + p, 0);

    weightEl.textContent = String(weight);
    for (const lbl of unitLabels) lbl.textContent = unit;
    barEl.textContent = String(customBar);
    perSideEl.textContent = String(perSideTotal);
    countEl.textContent = String(perSide.length);

    leftStack.innerHTML = '';
    rightStack.innerHTML = '';
    for (const p of perSide) { leftStack.appendChild(renderPlate(p)); rightStack.appendChild(renderPlate(p)); }
    if (collar) collar.style.display = perSide.length > 0 ? '' : 'none';
    renderCaption(perSide);

    if (plateListEl) {
      if (!perSide.length) {
        plateListEl.innerHTML = '<div class="pl-row pl-just-bar">Just the bar</div>';
      } else {
        plateListEl.innerHTML = groupPlates(perSide).map(g =>
          `<div class="pl-row"><span class="pl-weight">${plateLabel(g.weight)} <span class="pl-unit">${unit.toUpperCase()}</span></span><span class="pl-count">× ${g.count} per side</span></div>`
        ).join('');
      }
    }

    if (resultNoteEl) {
      if (weight < customBar) {
        resultNoteEl.textContent = `Weight is below bar weight (${customBar} ${unit}).`;
        resultNoteEl.className = 'pc-result-note warn';
      } else {
        resultNoteEl.textContent = '';
        resultNoteEl.className = 'pc-result-note';
      }
    }

    pBar.setAttribute('aria-label', perSide.length
      ? `${weight} ${unit} — bar plus ${perSideTotal} ${unit} per side`
      : `${weight} ${unit} — bar only`);

    decBtn.disabled = weight - step < customBar;
    incBtn.disabled = weight + step > MAX_BY_UNIT[unit];

    if (weightInputField) { weightInputField.value = String(weight); weightInputField.step = String(step); }

    for (const opt of unitOpts) {
      const on = opt.dataset.plateUnit === unit;
      opt.classList.toggle('active', on);
      opt.setAttribute('aria-selected', String(on));
    }
    for (const opt of barOpts) {
      const on = parseInt(opt.dataset.barLb ?? '45', 10) === barLb;
      opt.classList.toggle('active', on);
      opt.setAttribute('aria-pressed', String(on));
    }
  }

  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const unitBtn = t.closest<HTMLButtonElement>('[data-plate-unit]');
    if (unitBtn && unitBtn.dataset.plateUnit !== unit) {
      const newUnit = unitBtn.dataset.plateUnit as Unit;
      weight = convertWeight(weight, unit, newUnit);
      unit = newUnit;
      render(); return;
    }
    const barBtn = t.closest<HTMLButtonElement>('[data-bar-lb]');
    if (barBtn) {
      const nb = parseInt(barBtn.dataset.barLb ?? '45', 10);
      if (nb !== barLb) { barLb = nb; render(); } return;
    }
    const stepBtn = t.closest<HTMLButtonElement>('[data-plate-step]');
    if (stepBtn) {
      const step = stepFor(unit);
      const dir = stepBtn.dataset.plateStep === 'inc' ? 1 : -1;
      weight = Math.max(getCustomBar(), Math.min(MAX_BY_UNIT[unit], weight + dir * step));
      render(); return;
    }
  });

  weightInputField?.addEventListener('change', () => {
    const v = parseFloat(weightInputField!.value);
    if (!isNaN(v) && v > 0) { weight = Math.max(getCustomBar(), v); render(); }
  });

  copyBtn?.addEventListener('click', () => {
    const url = new URL(window.location.href);
    url.searchParams.set('unit', unit);
    url.searchParams.set('bar', String(barLb));
    url.searchParams.set('w', String(weight));
    navigator.clipboard.writeText(url.toString()).then(() => {
      if (copyConfirm) { copyConfirm.textContent = 'Copied!'; setTimeout(() => { copyConfirm!.textContent = ''; }, 2000); }
    });
  });

  render();


</script>

<style>
  .wrap {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .dot { color: var(--amber); }

  .caps {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* ── hero ── */
  .tool-hero {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .tool-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, var(--line-faint) 1px, transparent 1px);
    background-size: 96px 100%;
    opacity: 0.5;
    pointer-events: none;
  }
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 20px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .breadcrumb a:hover { color: var(--ink-0); }
  .breadcrumb .sep { color: var(--line-strong); }

  h1 {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(40px, 5.5vw, 72px);
    line-height: 0.97;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    color: var(--ink-0);
    position: relative;
  }
  .lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-1);
    max-width: 44ch;
    margin: 0;
    position: relative;
  }

  /* ── tool section ── */
  .tool-section {
    padding: 56px 0 80px;
  }

  /* ── plate card (matches home page #plate section) ── */
  .plate-card {
    border: 1px solid var(--line-strong);
    background: var(--bg-1);
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    margin-bottom: 48px;
  }
  .pc-left {
    padding: 44px;
    border-right: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 420px;
  }
  .pc-right {
    padding: 44px 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-0);
    min-width: 0;
  }
  .pc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pc-bar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }
  .pc-unit-toggle {
    display: inline-flex;
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
  }
  .pc-unit-opt {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    padding: 6px 12px;
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
  }
  .pc-unit-opt:hover { color: var(--ink-0); }
  .pc-unit-opt.active { background: var(--ink-0); color: var(--bg-0); }
  .pc-unit-opt:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .pc-target {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .pc-target h3 {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 36px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--ink-0);
    min-width: 8ch;
  }
  .pc-unit { color: var(--ink-2); font-weight: 500; }
  .pc-step {
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    border-radius: 0;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pc-step:hover { background: var(--ink-0); color: var(--bg-0); }
  .pc-step:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .pc-step:disabled { opacity: 0.35; cursor: not-allowed; }
  .pc-step:disabled:hover { background: var(--bg-0); color: var(--ink-0); }
  .pc-readout {
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
  }
  .pc-readout .item .l {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .pc-readout .item .v {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.025em;
    margin-top: 4px;
    color: var(--ink-0);
  }
  .pc-readout .item .v .unit {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--ink-2);
    text-transform: uppercase;
  }
  .pc-plate-list {
    border-top: 1px solid var(--line-faint);
    padding-top: 12px;
  }
  /* .pl-row and child classes are in <style is:global> below —
     they are injected via innerHTML so the scoped hash won't reach them. */
  .pc-result-note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .pc-result-note.warn { color: var(--amber); }
  .pc-extras {
    border-top: 1px solid var(--line-faint);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pc-input-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pc-direct-input {
    appearance: none;
    background: var(--bg-0);
    border: 1px solid var(--line-strong);
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 6px 10px;
    width: 100px;
    outline: none;
    transition: border-color var(--duration-base) var(--ease-standard);
  }
  .pc-direct-input:focus { border-color: var(--ink-0); }

  .share-row {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .copy-link-btn {
    background: transparent;
    border: 1px solid var(--line-strong);
    padding: 8px 14px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-1);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .copy-link-btn:hover {
    background: var(--bg-2);
    color: var(--ink-0);
  }
  .copy-confirm {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
  }

  /* ── page CTA ── */
  .page-cta {
    border: 1px solid var(--line-strong);
    background: var(--bg-1);
    padding: 32px 36px;
    display: flex;

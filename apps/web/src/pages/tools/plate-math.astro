---
import Base from '~/layouts/Base.astro';
---

<Base
  title="Plate Calculator — 531 Strength"
  description="Enter any weight and see exactly which plates to load on the barbell. Free plate math calculator for 5/3/1 and any strength program."
  ogImage="/screenshot-2.png"
>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Plate Calculator — 531 Strength",
    "applicationCategory": "SportsApplication",
    "description": "Enter any weight and see exactly which plates to load on the barbell. Free plate math calculator for 5/3/1 and any strength program.",
    "url": "https://531strength.com/tools/plate-math",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": [
      "lbs and kg support",
      "Multiple bar weights (45lb, 35lb, 20kg, 15kg)",
      "Visual plate layout per side",
      "No account required"
    ]
  }
  </script>

  <section class="tool-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href="/tools">TOOLS</a>
        <span class="sep">›</span>
        <span>PLATE CALCULATOR</span>
      </div>
      <h1>Plate calculator<span class="dot">.</span></h1>
      <p class="lede">
        Enter a target weight, pick your bar, and see exactly which plates to load on each side.
      </p>
    </div>
  </section>

  <section class="tool-section">
    <div class="wrap">
      <div class="tool-card" id="plate-calc">

        {/* Unit toggle */}
        <div class="segment-row">
          <div class="segment-label caps">UNIT</div>
          <div class="segment-group" role="group" aria-label="Select unit">
            <button class="seg-btn active" data-unit="lb" id="btn-lb" aria-pressed="true">LBS</button>
            <button class="seg-btn" data-unit="kg" id="btn-kg" aria-pressed="false">KG</button>
          </div>
        </div>

        {/* Bar selector */}
        <div class="segment-row border-top">
          <div class="segment-label caps">BAR WEIGHT</div>
          <div class="bar-options" role="group" aria-label="Select bar weight" id="bar-options">
            <button class="bar-btn active" data-bar-lb="45" data-bar-kg="20" data-bar-id="standard" aria-pressed="true">
              <span class="bar-name">STANDARD</span>
              <span class="bar-val" id="barlabel-standard">45 LB</span>
            </button>
            <button class="bar-btn" data-bar-lb="35" data-bar-kg="15" data-bar-id="womens" aria-pressed="false">
              <span class="bar-name">WOMEN'S</span>
              <span class="bar-val" id="barlabel-womens">35 LB</span>
            </button>
          </div>
        </div>

        {/* Weight input */}
        <div class="input-row border-top">
          <label class="input-label caps" for="target-weight">TARGET WEIGHT</label>
          <div class="input-group">
            <button class="step-btn" id="btn-dec" aria-label="Decrease weight">−</button>
            <div class="weight-display">
              <span class="weight-num" id="weight-display">135</span>
              <span class="weight-unit caps" id="weight-unit-label">LB</span>
            </div>
            <button class="step-btn" id="btn-inc" aria-label="Increase weight">+</button>
          </div>
          <div class="input-hint caps" id="step-hint">STEP: 5 LB</div>
        </div>

        {/* Direct input */}
        <div class="direct-row border-top">
          <label class="caps" for="weight-input-field">OR ENTER DIRECTLY</label>
          <input
            type="number"
            id="weight-input-field"
            class="weight-input"
            value="135"
            min="0"
            step="5"
            aria-label="Enter target weight"
          />
        </div>

        {/* Result */}
        <div class="result-section border-top" id="result-section">
          <div class="result-header">
            <span class="caps">PLATES PER SIDE</span>
            <span class="result-total caps" id="result-total">135 LB · 45 BAR</span>
          </div>

          <div class="plate-visual" id="plate-visual" aria-live="polite" aria-label="Plate layout">
            <!-- filled by JS -->
          </div>

          <div class="plate-list" id="plate-list" aria-label="Plate list">
            <!-- filled by JS -->
          </div>

          <div class="result-note" id="result-note"></div>
          <div class="share-row">
            <button class="copy-link-btn caps" id="copy-link-btn" type="button">Copy shareable link</button>
            <span class="copy-confirm caps" id="copy-confirm" aria-live="polite"></span>
          </div>
        </div>
      </div>

      {/* CTA */}
      <div class="page-cta">
        <div class="cta-left">
          <div class="caps cta-label">USE IN THE APP</div>
          <p>
            The 531 Strength app shows plate math live for every working set — no mental math during your session.
          </p>
        </div>
        <div class="cta-right">
          <a href="https://github.com/alexcheuk/proof-531/releases" rel="noopener" class="pill ghost">Download for Android →</a>
          <span class="pill ghost disabled" aria-label="iOS App Store coming soon">iOS · Soon</span>
        </div>
      </div>

      {/* FAQ / context section */}
      <div class="faq-section">
        <h2 class="faq-heading">How to use this calculator</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>What is plate math?</h3>
            <p>Plate math is the process of figuring out which weight plates to load on a barbell to hit a target weight. You subtract the bar weight (usually 45 lb / 20 kg), divide the remainder in half to get the per-side load, then match that against your available plates — starting with the heaviest and working down. This calculator does it automatically.</p>
          </div>
          <div class="faq-item">
            <h3>How does 5/3/1 plate math work?</h3>
            <p>In Jim Wendler's 5/3/1 program, your working weights are percentages of your training max. If your squat training max is 300 lb, your Week 1 working set at 65% is 195 lb. Enter 195 in this calculator: subtract the 45 lb bar, split 150 lb across two sides — 75 lb per side, loaded as 45+25+5. The calculator handles this for every set instantly.</p>
          </div>
          <div class="faq-item">
            <h3>Standard vs. Women's bar</h3>
            <p>A standard Olympic barbell weighs 45 lb (20 kg). A women's Olympic bar weighs 35 lb (15 kg). Select the correct bar type before calculating — the starting weight changes the plate breakdown. Most commercial squat racks and bench stations use the standard 45 lb bar.</p>
          </div>
          <div class="faq-item">
            <h3>Shareable links</h3>
            <p>Every calculator state has a unique URL — weight, unit, and bar type are encoded in the query string. Use "Copy shareable link" to grab the current configuration and send it to a training partner or save it for a specific working weight you check often.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
(function () {
  // ── state ──────────────────────────────────────────────────────────────
  var state = {
    unit: 'lb',
    barLb: 45,
    weight: 135,
  };

  // ── plate sets (lbs / kg) ──────────────────────────────────────────────
  var PLATES_LB = [100, 55, 45, 35, 25, 10, 5, 2.5, 1.25];
  var PLATES_KG = [50, 25, 20, 15, 10, 5, 2.5, 1.25, 0.5];

  // visual widths (relative) for each plate size
  var PLATE_WIDTH_LB = { 100: 56, 55: 48, 45: 44, 35: 38, 25: 34, 10: 28, 5: 22, 2.5: 16, 1.25: 12 };
  var PLATE_WIDTH_KG = { 50: 56, 25: 44, 20: 40, 15: 36, 10: 30, 5: 24, 2.5: 18, 1.25: 14, 0.5: 10 };

  // ── DOM refs ───────────────────────────────────────────────────────────
  var weightDisplay = document.getElementById('weight-display');
  var weightUnitLabel = document.getElementById('weight-unit-label');
  var stepHint = document.getElementById('step-hint');
  var resultTotal = document.getElementById('result-total');
  var plateVisual = document.getElementById('plate-visual');
  var plateList = document.getElementById('plate-list');
  var resultNote = document.getElementById('result-note');
  var weightInputField = document.getElementById('weight-input-field');

  // ── helpers ───────────────────────────────────────────────────────────
  function getBarKg() {
    return state.barLb === 45 ? 20 : 15;
  }

  function getCurrentBarWeight() {
    return state.unit === 'lb' ? state.barLb : getBarKg();
  }

  function getPlates() {
    return state.unit === 'lb' ? PLATES_LB : PLATES_KG;
  }

  function getStep() {
    return state.unit === 'lb' ? 5 : 2.5;
  }

  function fmtWeight(w) {
    // Show as integer if whole, one decimal if .5 or .25
    if (w % 1 === 0) return String(w);
    if ((w * 10) % 1 === 0) return w.toFixed(1);
    return w.toFixed(2);
  }

  function calcPlates(targetWeight) {
    var bar = getCurrentBarWeight();
    var plates = getPlates();
    var widths = state.unit === 'lb' ? PLATE_WIDTH_LB : PLATE_WIDTH_KG;
    var remaining = (targetWeight - bar) / 2;
    var result = [];

    if (remaining < 0) return { plates: [], remaining: remaining };

    for (var i = 0; i < plates.length; i++) {
      var p = plates[i];
      if (remaining >= p) {
        var count = Math.floor(remaining / p);
        result.push({ weight: p, count: count, width: widths[p] || 20 });
        remaining = Math.round((remaining - count * p) * 1000) / 1000;
      }
    }
    return { plates: result, remaining: remaining };
  }

  // ── render ─────────────────────────────────────────────────────────────
  function render() {
    var w = state.weight;
    var unitLabel = state.unit === 'lb' ? 'LB' : 'KG';
    var barW = getCurrentBarWeight();
    var step = getStep();

    weightDisplay.textContent = fmtWeight(w);
    weightUnitLabel.textContent = unitLabel;
    stepHint.textContent = 'STEP: ' + fmtWeight(step) + ' ' + unitLabel;
    resultTotal.textContent = fmtWeight(w) + ' ' + unitLabel + ' · ' + fmtWeight(barW) + ' ' + unitLabel + ' BAR';

    var calc = calcPlates(w);

    // bar-label buttons
    var barBtns = document.querySelectorAll('.bar-btn');
    barBtns.forEach(function (btn) {
      var lb = parseFloat(btn.dataset.barLb);
      var kg = parseFloat(btn.dataset.barKg);
      var val = state.unit === 'lb' ? fmtWeight(lb) + ' LB' : fmtWeight(kg) + ' KG';
      btn.querySelector('.bar-val').textContent = val;
    });

    // update input field
    weightInputField.value = fmtWeight(w);
    weightInputField.step = fmtWeight(step);

    // error state
    if (w < barW) {
      plateVisual.innerHTML = '';
      plateList.innerHTML = '';
      resultNote.textContent = 'Target weight is less than bar weight (' + fmtWeight(barW) + ' ' + unitLabel + ').';
      resultNote.className = 'result-note result-note--warn';
      return;
    }
    resultNote.textContent = '';
    resultNote.className = 'result-note';

    if (calc.remaining > 0.01) {
      resultNote.textContent = 'Note: ' + fmtWeight(calc.remaining) + ' ' + unitLabel + ' per side cannot be made with standard plates.';
      resultNote.className = 'result-note result-note--warn';
    }

    // plate visual (text-based barbell diagram)
    renderVisual(calc.plates, barW);

    // plate list
    renderList(calc.plates);
  }

  function renderVisual(plates, barW) {
    // Build a text-art barbell:
    //   [45][35][25] | BAR | [25][35][45]
    // We represent this with a flex row of plate divs + bar in center.
    var html = '<div class="barbell-diagram" role="img" aria-label="Barbell plate diagram">';

    // left side (plates in loading order: heaviest first from outside in)
    html += '<div class="bb-side bb-side--left">';
    for (var i = 0; i < plates.length; i++) {
      var p = plates[i];
      for (var j = 0; j < p.count; j++) {
        html += '<div class="bb-plate" style="--pw:' + p.width + 'px" aria-hidden="true">' +
          '<span class="bb-plate-label">' + fmtWeight(p.weight) + '</span>' +
          '</div>';
      }
    }
    html += '</div>';

    // bar collar + sleeve
    html += '<div class="bb-bar" aria-hidden="true"><div class="bb-collar"></div><div class="bb-sleeve"></div><div class="bb-center"><span>' + fmtWeight(barW) + '</span></div><div class="bb-sleeve"></div><div class="bb-collar"></div></div>';

    // right side (mirror)
    html += '<div class="bb-side bb-side--right">';
    for (var i2 = plates.length - 1; i2 >= 0; i2--) {
      var p2 = plates[i2];
      for (var j2 = 0; j2 < p2.count; j2++) {
        html += '<div class="bb-plate" style="--pw:' + p2.width + 'px" aria-hidden="true">' +
          '<span class="bb-plate-label">' + fmtWeight(p2.weight) + '</span>' +
          '</div>';
      }
    }
    html += '</div>';

    html += '</div>';
    plateVisual.innerHTML = html;
  }

  function renderList(plates) {
    if (plates.length === 0) {
      plateList.innerHTML = '<div class="empty-list caps">JUST THE BAR</div>';
      return;
    }
    var html = '';
    plates.forEach(function (p) {
      html += '<div class="plate-row">' +
        '<span class="plate-row-weight">' + fmtWeight(p.weight) + ' <span class="plate-row-unit">' + (state.unit === 'lb' ? 'LB' : 'KG') + '</span></span>' +
        '<span class="plate-row-count">× ' + p.count + ' per side</span>' +
        '</div>';
    });
    plateList.innerHTML = html;
  }

  // ── event handlers ─────────────────────────────────────────────────────
  // unit toggle
  document.querySelectorAll('.seg-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var newUnit = this.dataset.unit;
      if (newUnit === state.unit) return;

      // convert weight
      if (newUnit === 'kg') {
        state.weight = Math.round((state.weight / 2.20462) * 2) / 2; // round to 0.5
        state.barLb = state.barLb; // keep lb ref, use kg bar equivalent
      } else {
        state.weight = Math.round((state.weight * 2.20462) / 5) * 5;
      }
      state.unit = newUnit;

      document.querySelectorAll('.seg-btn').forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');

      // ensure weight is not below bar
      var minW = getCurrentBarWeight();
      if (state.weight < minW) state.weight = minW;

      render();
    });
  });

  // bar selector
  document.querySelectorAll('.bar-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.bar-btn').forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');
      state.barLb = parseFloat(this.dataset.barLb);
      render();
    });
  });

  // stepper buttons
  document.getElementById('btn-inc').addEventListener('click', function () {
    state.weight = Math.round((state.weight + getStep()) * 1000) / 1000;
    render();
  });
  document.getElementById('btn-dec').addEventListener('click', function () {
    var newW = Math.round((state.weight - getStep()) * 1000) / 1000;
    var minW = getCurrentBarWeight();
    if (newW >= minW) state.weight = newW;
    render();
  });

  // direct input
  weightInputField.addEventListener('change', function () {
    var v = parseFloat(this.value);
    if (!isNaN(v) && v >= 0) {
      state.weight = v;
      render();
    }
  });
  weightInputField.addEventListener('input', function () {
    var v = parseFloat(this.value);
    if (!isNaN(v) && v >= 0) {
      state.weight = v;
      render();
    }
  });

  // ── URL state ─────────────────────────────────────────────────────────
  function pushUrl() {
    var params = new URLSearchParams();
    params.set('w', String(state.weight));
    params.set('u', state.unit);
    if (state.barLb !== 45) params.set('b', String(state.barLb));
    history.replaceState(null, '', '?' + params.toString());
  }

  // Wrap render to also sync URL after every state mutation.
  var _render = render;
  render = function () { _render(); pushUrl(); };

  // ── copy link ─────────────────────────────────────────────────────────
  var copyBtn = document.getElementById('copy-link-btn');
  var copyConfirm = document.getElementById('copy-confirm');
  var copyTimer = null;
  copyBtn.addEventListener('click', function () {
    var url = window.location.href;
    navigator.clipboard.writeText(url).then(function () {
      copyConfirm.textContent = 'Copied!';
      if (copyTimer) clearTimeout(copyTimer);
      copyTimer = setTimeout(function () { copyConfirm.textContent = ''; }, 2000);
    }).catch(function () {
      copyConfirm.textContent = 'Copy failed';
    });
  });

  // ── init ───────────────────────────────────────────────────────────────
  (function initFromUrl() {
    var params = new URLSearchParams(window.location.search);
    var u = params.get('u');
    var w = params.get('w');
    var b = params.get('b');
    if (u === 'kg' || u === 'lb') state.unit = u;
    if (b === '35') state.barLb = 35;
    var parsed = w ? parseFloat(w) : NaN;
    if (!isNaN(parsed) && parsed > 0) state.weight = parsed;

    // Sync UI toggles to URL-loaded state
    document.querySelectorAll('.seg-btn').forEach(function (btn) {
      var active = btn.dataset.unit === state.unit;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
    document.querySelectorAll('.bar-btn').forEach(function (btn) {
      var active = parseFloat(btn.dataset.barLb) === state.barLb;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
  })();

  render();
})();
</script>

<style>
  .wrap {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .dot { color: var(--amber); }

  .caps {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* ── hero ── */
  .tool-hero {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .tool-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, var(--line-faint) 1px, transparent 1px);
    background-size: 96px 100%;
    opacity: 0.5;
    pointer-events: none;
  }
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 20px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumb a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-standard);
  }
  .breadcrumb a:hover { color: var(--ink-0); }
  .breadcrumb .sep { color: var(--line-strong); }

  h1 {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: clamp(40px, 5.5vw, 72px);
    line-height: 0.97;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    color: var(--ink-0);
    position: relative;
  }
  .lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-1);
    max-width: 44ch;
    margin: 0;
    position: relative;
  }

  /* ── tool section ── */
  .tool-section {
    padding: 56px 0 80px;
  }

  /* ── card ── */
  .tool-card {
    border: 1px solid var(--line-strong);
    background: var(--bg-0);
    margin-bottom: 48px;
  }

  .border-top { border-top: 1px solid var(--line); }

  /* ── unit / segment row ── */
  .segment-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    gap: 16px;
  }
  .segment-label { flex-shrink: 0; }
  .segment-group {
    display: flex;
    border: 1px solid var(--line-strong);
  }
  .seg-btn {
    appearance: none;
    border: none;
    background: transparent;
    padding: 8px 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    cursor: pointer;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
  }
  .seg-btn + .seg-btn { border-left: 1px solid var(--line-strong); }
  .seg-btn:hover { color: var(--ink-0); }
  .seg-btn.active {
    background: var(--ink-0);
    color: var(--bg-0);
  }

  /* ── bar selector ── */
  .bar-options {
    display: flex;
    border: 1px solid var(--line-strong);
  }
  .bar-btn {
    appearance: none;
    border: none;
    background: transparent;
    padding: 10px 20px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    transition: background var(--duration-base) var(--ease-standard);
  }
  .bar-btn + .bar-btn { border-left: 1px solid var(--line-strong); }
  .bar-btn:hover { background: var(--bg-1); }
  .bar-btn.active { background: var(--ink-0); }
  .bar-btn.active .bar-name,
  .bar-btn.active .bar-val { color: var(--bg-0) !important; }
  .bar-name {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color var(--duration-base) var(--ease-standard);
  }
  .bar-val {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-1);
    transition: color var(--duration-base) var(--ease-standard);
  }

  /* ── weight input row ── */
  .input-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
  }
  .input-label { white-space: nowrap; }
  .input-group {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
  }
  .weight-display {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 120px;
    justify-content: center;
  }
  .weight-num {
    font-family: var(--font-cond);
    font-weight: 600;
    font-size: 48px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink-0);
    font-variant-numeric: tabular-nums;
  }
  .weight-unit {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--ink-2);
  }
  .step-btn {
    appearance: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--ink-0);
    background: var(--bg-0);
    color: var(--ink-0);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
    flex-shrink: 0;
  }
  .step-btn:hover {
    background: var(--ink-0);
    color: var(--bg-0);
  }
  .input-hint {
    text-align: right;
    white-space: nowrap;
    font-size: 9px;

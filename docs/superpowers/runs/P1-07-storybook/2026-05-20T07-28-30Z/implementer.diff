diff --git a/apps/mobile/src/app/_storybook.tsx b/apps/mobile/src/app/_storybook.tsx
new file mode 100644
index 0000000..3d3f940
--- /dev/null
+++ b/apps/mobile/src/app/_storybook.tsx
@@ -0,0 +1,13 @@
+import type { ComponentType } from 'react';
+
+let StorybookUIRoot: ComponentType | null = null;
+if (__DEV__) {
+  StorybookUIRoot = require('../../.storybook').default as ComponentType;
+}
+
+export default function StorybookRoute() {
+  if (!__DEV__ || StorybookUIRoot === null) {
+    return null;
+  }
+  return <StorybookUIRoot />;
+}
